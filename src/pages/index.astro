---
import BaseLayout from '../layouts/BaseLayout.astro';
import Container from '../components/ui/Container.astro';
import Section from '../components/ui/Section.astro';
import SectionHeading from '../components/ui/SectionHeading.astro';
import Button from '../components/ui/Button.astro';
import TramiteCard from '../components/tramite/TramiteCard.astro';
import PerfilSwitch from '../components/tramite/PerfilSwitch.astro';
import StepsRow from '../components/tramite/StepsRow.astro';
import LogoCloud from '../components/home/LogoCloud.astro';
import Ventajas from '../components/home/Ventajas.astro';
import HeroFondo from '../components/layout/HeroFondo.astro';

import home from '../content/home/index.json';
import { getTramites } from '../lib/tramites';
import { resaltar } from '../lib/format';
import { empresa } from '../lib/config';
import { temaOscuro } from '../lib/tema';

const tramites = await getTramites();

/**
 * Los trámites marcados como destacados abren el listado en una fila propia:
 * son los que más se piden y la mayoría de visitas entran buscando uno de
 * ellos. El resto va debajo, en la rejilla de siempre.
 *
 * Si nadie ha marcado ninguno, no se inventa una primera fila: se pinta el
 * catálogo entero de una vez, como antes.
 */
const destacados = tramites.filter((tramite) => tramite.data.destacado);
const resto =
  destacados.length > 0 ? tramites.filter((tramite) => !tramite.data.destacado) : tramites;

const rejilla = 'grid grid-cols-2 gap-3 sm:gap-4 md:grid-cols-3 lg:grid-cols-4';
const titulos = home.tramites ?? { tituloDestacados: '', tituloTodos: '' };
---

<BaseLayout
  title={home.seo.metaTitle || empresa.name}
  description={home.seo.metaDescription || empresa.description}
>
  <!-- 1 · Cabecera -->
  <!-- El hero arranca pegado al borde superior de la página: la barra de
       navegación va integrada, sin fondo propio, y se pinta encima de este
       mismo color. El `pt` compensa su altura para que el titular no se meta
       debajo. El fondo lo pone `HeroFondo` según el tema elegido en el panel;
       aquí sólo se declara la superficie sobre la que se apoya. -->
  <Section spacing="none" tone="hero" class="relative -mt-16 overflow-hidden lg:-mt-18">
    <HeroFondo />

    <Container class="relative pt-30 pb-10 lg:pt-38 lg:pb-14">
      <!-- La nube de logos se ancla a este bloque, no al contenedor entero: se
           centra con `inset-y-0` y, si abarcara también la franja de abajo,
           bajaría hasta cruzarse con ella. -->
      <div class="relative">
        <LogoCloud oscuro={temaOscuro} />

        <div class="relative flex max-w-[42rem] flex-col gap-6">
          <h1
            class:list={['text-display', temaOscuro && 'text-white']}
            set:html={resaltar(home.hero.claim)}
          />
          <p
            class:list={[
              'max-w-[54ch] text-[1.125rem]',
              temaOscuro ? 'text-white/70' : 'text-ink-muted',
            ]}
          >
            {home.hero.subclaim}
          </p>
        </div>
      </div>

      <!-- Donde antes estaba el botón de WhatsApp. Lo que hay debajo es la
           rejilla de trámites, que es el verdadero punto de entrada; la franja
           resuelve las cuatro dudas comunes a todos ellos sin desviar a nadie a
           una conversación antes de tiempo.

           El margen es mayor que el que separa el claim del subclaim: tiene
           que despegarse tanto del texto como de las burbujas de logos, que
           al flotar pueden acabar más abajo que el propio párrafo. -->
      <Ventajas
        ventajas={home.hero.ventajas ?? []}
        oscuro={temaOscuro}
        class="relative mt-16 lg:mt-24"
      />
    </Container>
  </Section>

  <!-- 2 · Listado de trámites, sin categorías: la rejilla se explica sola y es
       el motivo por el que se entra en la home.
       Comparte el blanco con la cabecera; lo que separa un bloque de otro es
       el gris de las tarjetas, no un cambio de fondo. -->
  <Section id="tramites" spacing="none" tone="white">
    <Container class="flex flex-col gap-6 pt-16 pb-16 lg:pt-20 lg:pb-24">
      <!-- El selector de perfil va aquí, pegado a la rejilla, porque lo que
           cambia son los precios de las tarjetas que hay justo debajo. -->
      <div class="flex flex-col gap-4 sm:flex-row sm:items-end sm:justify-between">
        {
          destacados.length > 0 && titulos.tituloDestacados && (
            <h2 class="text-h2">{titulos.tituloDestacados}</h2>
          )
        }
        <PerfilSwitch size="sm" class="sm:ml-auto" />
      </div>

      {
        destacados.length > 0 && (
          <ul class="grid grid-cols-2 gap-3 sm:gap-4 lg:grid-cols-4">
            {destacados.map((tramite) => (
              <TramiteCard tramite={tramite} />
            ))}
          </ul>
        )
      }

      {
        resto.length > 0 && (
          <div class="flex flex-col gap-6 pt-6 lg:pt-10">
            {destacados.length > 0 && titulos.tituloTodos && (
              <h2 class="text-h2">{titulos.tituloTodos}</h2>
            )}
            <ul class={rejilla}>
              {resto.map((tramite) => (
                <TramiteCard tramite={tramite} />
              ))}
            </ul>
          </div>
        )
      }
    </Container>
  </Section>

  <!-- 3 · Cómo funciona -->
  <Section id="tramitar" tone="alt">
    <Container class="flex flex-col gap-10">
      <SectionHeading title={home.comoFunciona.titulo} subtitle={home.comoFunciona.subtitulo} />
      <StepsRow pasos={home.comoFunciona.pasos} />

      <div>
        <Button href="/como-funciona" variant="outline">Ver el proceso en detalle</Button>
      </div>
    </Container>
  </Section>
</BaseLayout>
