---
import { render } from 'astro:content';

import BaseLayout from '../../layouts/BaseLayout.astro';
import Container from '../../components/ui/Container.astro';
import Section from '../../components/ui/Section.astro';
import SectionHeading from '../../components/ui/SectionHeading.astro';
import Prose from '../../components/ui/Prose.astro';
import WhatsAppCTA from '../../components/tramite/WhatsAppCTA.astro';
import StepList from '../../components/tramite/StepList.astro';
import DocGrid from '../../components/tramite/DocGrid.astro';
import PriceBreakdown from '../../components/tramite/PriceBreakdown.astro';
import FaqAccordion from '../../components/tramite/FaqAccordion.astro';
import StickyMobileCTA from '../../components/layout/StickyMobileCTA.astro';
import CabeceraPagina from '../../components/layout/CabeceraPagina.astro';

import { getTramites, totalTramite, type Tramite } from '../../lib/tramites';
import { textoPlano } from '../../lib/format';
import { empresa } from '../../lib/config';

export async function getStaticPaths() {
  const tramites = await getTramites();
  return tramites.map((tramite) => ({
    params: { slug: tramite.id },
    props: { tramite },
  }));
}

interface Props {
  tramite: Tramite;
}

const { tramite } = Astro.props;
const { data } = tramite;
const { Content } = await render(tramite);

/**
 * El precio del JSON-LD es el de particular: es la tarifa pública, la que ve
 * quien llega desde el buscador y la que debe indexarse.
 */
const total = totalTramite(data.precio);
const mensaje = data.whatsappMensaje ?? `Hola, quiero información sobre: ${data.title}`;
const ctaLabel = data.ctaLabel ?? 'Empezar por WhatsApp';
const url = `${empresa.url}/tramites/${tramite.id}`;

/** La explicación del trámite abre el bloque de preguntas frecuentes. */
const preguntaDestacada = data.contenidoPregunta ?? `¿Qué es y cuándo se necesita?`;

const schema: Record<string, unknown>[] = [
  {
    '@context': 'https://schema.org',
    '@type': 'Service',
    name: data.title,
    description: data.summary,
    url,
    serviceType: data.shortTitle,
    provider: { '@id': `${empresa.url}/#organizacion` },
    areaServed: { '@type': 'Country', name: 'España' },
    offers: {
      '@type': 'Offer',
      price: total,
      priceCurrency: 'EUR',
      url,
      availability: 'https://schema.org/OnlineOnly',
    },
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    // Sin nivel intermedio «Trámites»: esa página ya no existe y un
    // BreadcrumbList no debe declarar una URL que redirige.
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Inicio', item: empresa.url },
      { '@type': 'ListItem', position: 2, name: data.shortTitle, item: url },
    ],
  },
];

/**
 * El FAQPage arranca con la explicación del trámite, igual que la página, para
 * que los datos estructurados reflejen lo que el usuario ve.
 */
const explicacion = tramite.body ? textoPlano(tramite.body) : '';
const faqsSchema = [
  ...(explicacion ? [{ pregunta: preguntaDestacada, respuesta: explicacion }] : []),
  ...data.faqs,
];

if (faqsSchema.length > 0) {
  schema.push({
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: faqsSchema.map((faq) => ({
      '@type': 'Question',
      name: faq.pregunta,
      acceptedAnswer: { '@type': 'Answer', text: faq.respuesta },
    })),
  });
}

/**
 * Bloques de la columna de contenido.
 *
 * La separación entre bloques la pone `divide-y` en el contenedor, que dibuja
 * el filete en todos menos en el primero. Antes cada sección traía el suyo y
 * quedaba una línea suelta justo debajo del titular.
 */
const bloque = 'flex scroll-mt-24 flex-col gap-8 py-12 lg:py-16';
---

<BaseLayout
  title={data.seo.metaTitle || data.title}
  description={data.seo.metaDescription || data.summary}
  schema={schema}
  stickyCta
>
  <!-- 1 · Titular, en la cabecera con el color y la textura del tema. Antes el
       titular vivía dentro de la rejilla y el color lo ponían unas manchas
       desenfocadas propias de esta página; ahora comparte cabecera con el
       resto del sitio y las manchas sobran. -->
  <CabeceraPagina
    titulo={data.hero.claim || data.title}
    entradilla={data.hero.subtitulo}
    tamano="display"
  />

  <!--
    El cuerpo es una rejilla de dos columnas en escritorio: el contenido a la
    izquierda y la tarjeta de precio a la derecha, que acompaña el scroll.
    Antes el precio salía dos veces —en la cabecera y en una sección propia más
    abajo— porque al bajar se perdía de vista; con la tarjeta fija esa
    repetición sobra y se ha retirado.

    La tarjeta va ANTES que el contenido en el DOM y se recoloca con
    `col-start`: en móvil, donde no hay dos columnas, el orden de lectura tiene
    que ser precio y después detalle.
  -->
  <!-- Sin `overflow-hidden` en la sección: un ancestro con overflow recortado
       rompe el `position: sticky` de la tarjeta. -->
  <Section spacing="none" tone="white" class="relative">
    <Container class="relative py-12 lg:py-16">
      <div
        class="grid gap-10 lg:grid-cols-[minmax(0,1fr)_minmax(0,21rem)] lg:items-start lg:gap-12"
      >
        <!-- 2 · Tarjeta de precio · el único CTA persistente en escritorio.
             `max-h` con scroll interno es una red de seguridad para pantallas
             bajas: si la tarjeta cabe, no aparece ninguna barra. -->
        <aside
          class="lg:sticky lg:top-24 lg:col-start-2 lg:row-start-1 lg:max-h-[calc(100vh-7rem)] lg:self-start lg:overflow-y-auto"
        >
          <PriceBreakdown
            precio={data.precio}
            plazo={data.hero.plazo}
            cta={{ mensaje, label: ctaLabel }}
          />
        </aside>

        <!-- 3 · Contenido del trámite -->
        <div class="flex flex-col divide-y divide-line lg:col-start-1 lg:row-start-1">
          {
            data.pasos.length > 0 && (
              <section id="pasos" class={bloque}>
                <SectionHeading
                  title="Pasos del proceso"
                  subtitle="De principio a fin, sin que tengas que pisar una oficina."
                />
                <StepList pasos={data.pasos} />
              </section>
            )
          }

          {
            data.documentacion.length > 0 && (
              <section id="documentacion" class={bloque}>
                <SectionHeading
                  title="Documentación necesaria"
                  subtitle="Esto es todo lo que tienes que reunir. Si te falta algo, dínoslo y te decimos cómo conseguirlo."
                />
                <DocGrid documentos={data.documentacion} />
              </section>
            )
          }

          <section id="faq" class={bloque}>
            <SectionHeading title="Preguntas frecuentes" />
            <FaqAccordion faqs={data.faqs} preguntaDestacada={preguntaDestacada}>
              <Prose slot="destacada">
                <Content />
              </Prose>
            </FaqAccordion>
          </section>
        </div>
      </div>
    </Container>
  </Section>

  <!-- 4 · CTA de cierre -->
  <Section spacing="none" tone="brand-dark">
    <Container class="py-14 lg:py-16">
      <div
        class="flex flex-col items-start gap-6 lg:flex-row lg:items-center lg:justify-between lg:gap-10"
      >
        <div class="flex flex-col gap-2">
          <h2 class="text-h2 text-white">¿Empezamos con tu {data.shortTitle.toLowerCase()}?</h2>
          <p class="max-w-[48ch] text-white/70">
            Escríbenos por WhatsApp y te decimos en el momento qué necesitamos y cuánto costará.
          </p>
        </div>
        <WhatsAppCTA mensaje={mensaje} label={ctaLabel} class="shrink-0" />
      </div>
    </Container>
  </Section>

  <StickyMobileCTA slot="after" mensaje={mensaje} label={ctaLabel} precio={data.precio} />
</BaseLayout>
