---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Container from '../../components/ui/Container.astro';
import Section from '../../components/ui/Section.astro';
import TramiteCard from '../../components/tramite/TramiteCard.astro';
import Breadcrumbs from '../../components/seo/Breadcrumbs.astro';
import { getTramites } from '../../lib/tramites';
import { empresa } from '../../lib/config';

const tramites = await getTramites();

const migas = [{ label: 'Trámites', href: '/tramites' }];
---

<BaseLayout
  title="Todos los trámites de vehículos"
  description={`Listado completo de los ${tramites.length} trámites de vehículos que gestionamos online: transferencias, matriculaciones, bajas, duplicados y más.`}
  schema={[
    {
      '@context': 'https://schema.org',
      '@type': 'CollectionPage',
      name: 'Trámites de vehículos',
      url: `${empresa.url}/tramites`,
    },
  ]}
>
  <Section spacing="tight" tone="brand-soft" class="border-b border-line">
    <Container class="flex flex-col gap-4">
      <Breadcrumbs items={migas} />
      <h1 class="text-h1">Todos los trámites</h1>
      <p class="max-w-[58ch] text-ink-muted">
        Estos son los {tramites.length} trámites que gestionamos ahora mismo. En cada uno encontrarás
        los pasos, la documentación exacta y el precio antes de contratar nada.
      </p>
    </Container>
  </Section>

  <Section>
    <Container>
      <ul class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
        {tramites.map((tramite) => <TramiteCard tramite={tramite} />)}
      </ul>
    </Container>
  </Section>
</BaseLayout>
