---
import { getCollection, render } from 'astro:content';

import BaseLayout from '../layouts/BaseLayout.astro';
import Container from '../components/ui/Container.astro';
import Section from '../components/ui/Section.astro';
import Prose from '../components/ui/Prose.astro';
import Breadcrumbs from '../components/seo/Breadcrumbs.astro';
import { fechaLarga } from '../lib/format';

/**
 * Solo genera las rutas de la colección `paginas` (/aviso-legal, /privacidad,
 * /cookies). Al ser un parámetro simple no colisiona con las rutas estáticas,
 * que Astro resuelve antes.
 */
export async function getStaticPaths() {
  const paginas = await getCollection('paginas');
  return paginas.map((pagina) => ({
    params: { legal: pagina.id },
    props: { pagina },
  }));
}

const { pagina } = Astro.props;
const { Content } = await render(pagina);
---

<BaseLayout title={pagina.data.title} description={pagina.data.descripcion ?? undefined}>
  <Section spacing="tight" tone="brand-soft" class="border-b border-line">
    <Container class="flex flex-col gap-4">
      <Breadcrumbs items={[{ label: pagina.data.title, href: `/${pagina.id}` }]} />
      <h1 class="text-h1">{pagina.data.title}</h1>
      {
        pagina.data.actualizado && (
          <p class="text-small text-ink-muted">
            Última actualización: {fechaLarga(pagina.data.actualizado)}
          </p>
        )
      }
    </Container>
  </Section>

  <Section>
    <Container>
      <Prose>
        <Content />
      </Prose>
    </Container>
  </Section>
</BaseLayout>
