---
/**
 * Estudio de imagen de marca: la lista de piezas para redes o de tarjetas de
 * visita, con su miniatura. Es a donde lleva el grupo «Imagen de marca» del
 * menú del panel. Cada tarjeta abre el editor (`[slug]/index.astro`) y lleva
 * un botón para borrarla sin abrirla.
 *
 * Las miniaturas se piden con la entrada ya leída en la URL (`?borrador=…`),
 * no por slug: así nunca salen de una caché anterior al último guardado.
 */
import MarcaLayout from '../../../layouts/MarcaLayout.astro';
import { listarEntradas, SinSesion } from '../../../lib/marca/datos';
import { codificarBorrador, esTipo, type EntradaPieza } from '../../../lib/marca/entradas';
import { PLANTILLAS } from '../../../lib/marca/opciones';
import { consultaRama, ramaDe } from '../../../lib/marca/rama';

export const prerender = false;

const { tipo } = Astro.params;
if (!esTipo(tipo)) return new Response('No encontrado', { status: 404 });
const rama = ramaDe(Astro.url.searchParams.get('rama'));

let entradas;
try {
  entradas = await listarEntradas(Astro.cookies, rama, tipo);
} catch (error) {
  if (error instanceof SinSesion)
    return Astro.redirect(`/marca/entrar?volver=${encodeURIComponent(Astro.url.pathname + Astro.url.search)}`);
  throw error;
}

const piezas = tipo === 'piezas';
const titulo = piezas ? 'Imágenes para redes' : 'Tarjetas de visita';
const miniatura = piezas ? 'instagram-post' : 'anverso';
const plantilla = (e: EntradaPieza) => PLANTILLAS.find((p) => p.value === e.plantilla.discriminant)?.label ?? '';
const q = consultaRama(rama);
---

<MarcaLayout titulo={titulo} tipo={tipo} rama={rama}>
  <main class="mx-auto flex max-w-[1600px] flex-col gap-8 px-4 py-10 sm:px-6">
    <div class="flex flex-wrap items-end justify-between gap-6">
      <div class="flex max-w-[70ch] flex-col gap-2">
        <h1 class="text-h1">{titulo}</h1>
        <p class="text-ink-muted">
          {
            piezas
              ? 'Cada pieza se genera en todos los formatos de Instagram, WhatsApp, LinkedIn, Facebook y YouTube, lista para descargar en PNG, JPG, SVG y PDF.'
              : 'Una tarjeta por persona, en el tamaño estándar de 85 × 55 mm, con el PDF listo para la imprenta.'
          }
        </p>
      </div>
      <a
        href={`/marca/${tipo}/nueva${q}`}
        class="inline-flex items-center gap-2 rounded-md bg-accent-500 px-5 py-3 font-display font-semibold text-white hover:bg-accent-600"
      >
        + {piezas ? 'Nueva pieza' : 'Nueva tarjeta'}
      </a>
    </div>

    {
      entradas.length === 0 ? (
        <div class="rounded-lg border border-dashed border-line bg-white p-10 text-center text-ink-muted">
          Todavía no hay ninguna. Empieza con «{piezas ? 'Nueva pieza' : 'Nueva tarjeta'}».
        </div>
      ) : (
        <ul class:list={['grid gap-5', piezas ? 'grid-cols-2 md:grid-cols-3 xl:grid-cols-5' : 'grid-cols-1 sm:grid-cols-2 xl:grid-cols-4']}>
          {entradas.map(({ slug, entrada }) => (
            <li class="group/pieza relative" data-pieza={slug}>
              <a
                href={`/marca/${tipo}/${slug}${q}`}
                class="group flex h-full flex-col overflow-hidden rounded-lg border border-line bg-white hover:border-brand-100 hover:shadow-md"
              >
                <div class:list={['flex items-center justify-center bg-surface-muted', piezas ? 'aspect-square p-4' : 'p-6']}>
                  <img
                    src={`/marca/${tipo}/${slug}/${miniatura}.svg${consultaRama(rama, `borrador=${codificarBorrador(entrada)}`)}`}
                    alt=""
                    loading="lazy"
                    class:list={['max-h-full max-w-full shadow-sm', !piezas && 'w-full rounded-sm']}
                    style={piezas ? 'aspect-ratio:1/1' : 'aspect-ratio:91/61'}
                  />
                </div>
                <div class="flex flex-col gap-0.5 p-4">
                  <h2 class="font-display text-base font-semibold text-brand-900 group-hover:text-accent-600">
                    {entrada.nombre || slug}
                  </h2>
                  <p class="text-sm text-ink-muted">
                    {piezas ? plantilla(entrada as EntradaPieza) : (entrada as { cargo: string }).cargo || '—'}
                  </p>
                </div>
              </a>
              <button
                type="button"
                data-borrar={slug}
                data-nombre={entrada.nombre || slug}
                aria-label={`Borrar «${entrada.nombre || slug}»`}
                title="Borrar"
                class="absolute top-2 right-2 flex size-9 items-center justify-center rounded-md border border-line bg-white/95 text-ink-muted shadow-sm hover:border-red-200 hover:bg-red-50 hover:text-danger focus-visible:opacity-100 disabled:opacity-50 sm:opacity-0 sm:group-hover/pieza:opacity-100"
              >
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                  <path d="M3 6h18M8 6V4h8v2M19 6l-1 14H6L5 6M10 11v6M14 11v6" />
                </svg>
              </button>
            </li>
          ))}
        </ul>
      )
    }
    <p id="aviso-borrado" role="alert" class="hidden rounded-md bg-red-50 px-4 py-3 text-sm text-danger"></p>
  </main>
</MarcaLayout>

<script>
  import { peticionMarca } from '../../../lib/marca/cliente';
  import { esTipo } from '../../../lib/marca/entradas';

  // Borrar desde la lista, sin tener que abrir la pieza.
  const tipo = location.pathname.split('/')[2];
  const rama = new URLSearchParams(location.search).get('rama');
  const aviso = document.getElementById('aviso-borrado')!;

  document.querySelectorAll<HTMLButtonElement>('button[data-borrar]').forEach((boton) => {
    boton.addEventListener('click', async () => {
      const slug = boton.dataset.borrar!;
      if (!esTipo(tipo) || !window.confirm(`¿Borrar «${boton.dataset.nombre}»? Desaparecerá de la lista y del panel.`)) return;
      boton.disabled = true;
      aviso.classList.add('hidden');
      try {
        await peticionMarca(tipo, 'DELETE', { rama, slug });
        boton.closest('li')?.remove();
        if (!document.querySelector('li[data-pieza]')) location.reload();
      } catch (error) {
        boton.disabled = false;
        aviso.textContent =
          error instanceof Error && error.message === 'sin-sesion'
            ? 'La sesión del panel ha caducado. Entra de nuevo en el panel y vuelve a intentarlo.'
            : `No se ha podido borrar: ${error instanceof Error ? error.message : error}`;
        aviso.classList.remove('hidden');
      }
    });
  });
</script>
