---
/**
 * Estudio de imagen de marca: el editor de una pieza para redes o de una
 * tarjeta de visita, con la vista previa en vivo y las descargas en la misma
 * pantalla. `/marca/<tipo>/nueva` abre el editor vacío.
 *
 * Es también la «Vista previa» de estas colecciones en el panel, así que
 * cualquier camino para llegar a una pieza acaba aquí.
 */
import { getCollection } from 'astro:content';

import MarcaLayout from '../../../../layouts/MarcaLayout.astro';
import Estudio from '../../../../components/marca/Estudio';
import { empresa } from '../../../../lib/config';
import { leerEntrada, SinSesion } from '../../../../lib/marca/datos';
import { esTipo, nuevaEntrada } from '../../../../lib/marca/entradas';
import { ramaDe } from '../../../../lib/marca/rama';

export const prerender = false;

const { tipo, slug = '' } = Astro.params;
if (!esTipo(tipo)) return new Response('No encontrado', { status: 404 });
const rama = ramaDe(Astro.url.searchParams.get('rama'));
const nueva = slug === 'nueva';

let entrada;
try {
  entrada = nueva ? nuevaEntrada(tipo) : await leerEntrada(Astro.cookies, rama, tipo, slug);
} catch (error) {
  if (error instanceof SinSesion)
    return Astro.redirect(`/marca/entrar?volver=${encodeURIComponent(Astro.url.pathname + Astro.url.search)}`);
  throw error;
}
if (!entrada) return new Response('No encontrado', { status: 404 });

// Para el desplegable de la plantilla «Trámite con precio». Salen del último
// despliegue: un trámite recién creado en el panel aparece al publicarse.
const tramites = (await getCollection('tramites'))
  .map((t) => ({
    value: t.id,
    label: t.data.estado === 'borrador' ? `${t.data.title} (borrador)` : t.data.title,
  }))
  .sort((a, b) => a.label.localeCompare(b.label, 'es'));

const titulo = entrada.nombre || (tipo === 'piezas' ? 'Nueva pieza' : 'Nueva tarjeta');
---

<MarcaLayout titulo={titulo} tipo={tipo} rama={rama}>
  <Estudio
    client:load
    tipo={tipo}
    slug={nueva ? null : slug}
    rama={rama}
    inicial={entrada}
    tramites={tramites}
    empresa={{ telefono: empresa.telefono, email: empresa.email }}
    local={!import.meta.env.PROD}
  />
</MarcaLayout>
