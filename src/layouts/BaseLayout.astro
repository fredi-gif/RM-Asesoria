---
import '../styles/global.css';

import Header from '../components/layout/Header.astro';
import Footer from '../components/layout/Footer.astro';
import JsonLd from '../components/seo/JsonLd.astro';
import { empresa } from '../lib/config';
import { PERFIL_POR_DEFECTO } from '../lib/tramites';
import { tema } from '../lib/tema';
import { LANG } from '../config/site';

interface Props {
  title: string;
  description?: string;
  /** Datos estructurados adicionales de la página (Service, FAQPage…). */
  schema?: Record<string, unknown>[];
  noindex?: boolean;
  /** Deja hueco al final para la barra fija de móvil. */
  stickyCta?: boolean;
  /**
   * `integrada` quita el fondo a la barra de navegación para que se vea el
   * hero por debajo, y activa el tema de color elegido en el panel. Sólo lo
   * pide la home: es la única página con hero de color.
   */
  header?: 'solida' | 'integrada';
}

const {
  title,
  description = empresa.description,
  schema = [],
  noindex = false,
  stickyCta = false,
  header = 'solida',
} = Astro.props;

const canonical = new URL(Astro.url.pathname, Astro.site ?? empresa.url).href;
const tituloCompleto = title.includes(empresa.name) ? title : `${title} | ${empresa.name}`;

/**
 * Organization + LocalBusiness van en todas las páginas: es lo que permite a
 * Google asociar los datos de contacto y el nombre comercial con el dominio.
 */
const organizacion = {
  '@context': 'https://schema.org',
  '@type': 'ProfessionalService',
  '@id': `${empresa.url}/#organizacion`,
  name: empresa.name,
  legalName: empresa.legal.razonSocial,
  description: empresa.description,
  url: empresa.url,
  email: empresa.email,
  telephone: empresa.telefono,
  taxID: empresa.legal.cif,
  areaServed: { '@type': 'Country', name: 'España' },
  address: {
    '@type': 'PostalAddress',
    streetAddress: empresa.legal.direccion,
    addressCountry: 'ES',
  },
};
---

<!doctype html>
<!-- `data-perfil` manda sobre qué precio se ve en toda la web. Se sirve
     siempre con el de particular, que es el tráfico mayoritario y lo que debe
     indexar Google; el script de abajo lo cambia antes del primer pintado si
     el visitante ya eligió «profesionales» en otra página. -->
<html lang={LANG} data-perfil={PERFIL_POR_DEFECTO} data-tema={header === 'integrada' ? tema : undefined}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <meta name="generator" content={Astro.generator} />

    <title>{tituloCompleto}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex, nofollow" />}

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={empresa.name} />
    <meta property="og:locale" content="es_ES" />
    <meta property="og:title" content={tituloCompleto} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="theme-color" content="#0a1f44" />

    <!-- Va aquí y en línea, no como script del <head> normal: tiene que
         ejecutarse antes de pintar nada o el precio parpadearía del perfil de
         particular al de profesional. -->
    <script is:inline>
      try {
        if (localStorage.getItem('rm-perfil') === 'profesional') {
          document.documentElement.dataset.perfil = 'profesional';
        }
      } catch {
        /* Modo privado o cookies bloqueadas: se queda el perfil por defecto. */
      }
    </script>

    <JsonLd schema={organizacion} />
    {schema.map((item) => <JsonLd schema={item} />)}
  </head>

  <body class:list={['min-h-dvh', stickyCta && 'pb-20 lg:pb-0']}>
    <a
      href="#contenido"
      class="sr-only focus:not-sr-only focus:absolute focus:top-3 focus:left-3 focus:z-999 focus:rounded-md focus:bg-brand-900 focus:px-4 focus:py-2 focus:text-white"
    >
      Saltar al contenido
    </a>

    <Header variante={header} />
    <main id="contenido">
      <slot />
    </main>
    <Footer />
    <slot name="after" />

    <!--
      Selector de perfil de precio, para todas las instancias de la página: la
      de la home sobre la rejilla y la de la tarjeta de precio del trámite.

      El listener va delegado en el documento, así que da igual cuántos
      selectores haya y no hace falta un script por componente.
    -->
    <script>
      const CLAVE = 'rm-perfil';

      /** Marca el botón activo de todos los selectores que haya en la página. */
      function sincronizar(perfil: string) {
        document.querySelectorAll<HTMLElement>('[data-perfil-opcion]').forEach((boton) => {
          boton.setAttribute('aria-pressed', String(boton.dataset.perfilOpcion === perfil));
        });
      }

      document.addEventListener('click', (evento) => {
        const destino = evento.target as HTMLElement | null;
        const boton = destino?.closest<HTMLElement>('[data-perfil-opcion]');
        const perfil = boton?.dataset.perfilOpcion;
        if (!perfil) return;

        document.documentElement.dataset.perfil = perfil;
        sincronizar(perfil);
        try {
          localStorage.setItem(CLAVE, perfil);
        } catch {
          /* Sin almacenamiento el cambio vale solo para esta página. */
        }
      });

      // El script en línea del <head> ya pudo cambiar el perfil: aquí solo se
      // ponen al día los botones. No se escribe en localStorage, que guardaría
      // una elección que el visitante no ha hecho.
      sincronizar(document.documentElement.dataset.perfil ?? 'particular');
    </script>
  </body>
</html>
