---
/**
 * Set cerrado de iconos, inline y sin dependencias.
 *
 * Todos comparten rejilla 24, trazo 1.5 y remates redondeados, que es lo que
 * hace que el conjunto se lea como un sistema y no como iconos sueltos.
 *
 * Los nombres de la sección "trámites" son los que ofrece el select de
 * Keystatic: si añades uno aquí, añádelo también en `keystatic.config.ts`.
 */
export type IconName = keyof typeof PATHS;

const PATHS = {
  // --- Trámites ---
  coche: '<path d="M5 17h14M6.5 17v1.5a1 1 0 0 1-1 1h-1a1 1 0 0 1-1-1V17m14 0v1.5a1 1 0 0 0 1 1h1a1 1 0 0 0 1-1V17M3 17v-4.2a2 2 0 0 1 .21-.9l2.4-4.79A2 2 0 0 1 7.4 6h9.2a2 2 0 0 1 1.79 1.11l2.4 4.79a2 2 0 0 1 .21.9V17"/><path d="M3.5 12.5h17"/><circle cx="7.5" cy="14.5" r=".6" fill="currentColor" stroke="none"/><circle cx="16.5" cy="14.5" r=".6" fill="currentColor" stroke="none"/>',
  traspaso:
    '<path d="M3 8h13l-3-3M21 16H8l3 3"/><rect x="3" y="13" width="6" height="6" rx="1.2"/><rect x="15" y="5" width="6" height="6" rx="1.2"/>',
  documento:
    '<path d="M14 3H7a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h10a2 2 0 0 0 2-2V8z"/><path d="M14 3v5h5"/><path d="M8.5 12.5h7M8.5 16h4.5"/>',
  firma:
    '<path d="M3 18c2.5 0 3-3.5 4.2-7.4C8 8 8.8 6 10 6c1.4 0 1.3 2.2 1 4.6-.4 3-1 5.4.4 5.4 1 0 1.6-1.2 2.1-2.3"/><path d="M14 18h7"/><path d="M17.5 12.5 20 15l-3 1 1-3.5Z"/>',
  lupa: '<circle cx="11" cy="11" r="7"/><path d="m20 20-3.5-3.5"/><path d="M8.5 11h5M11 8.5v5"/>',
  matricula:
    '<rect x="2.5" y="6" width="19" height="12" rx="2"/><path d="M6 6v12"/><path d="M9.5 10.5h1.5M9.5 13.5h5M13.5 10.5h3"/><circle cx="4.2" cy="9" r=".55" fill="currentColor" stroke="none"/>',
  alta: '<circle cx="12" cy="12" r="8.5"/><path d="M12 8.5v7M8.5 12h7"/>',
  baja: '<path d="M4 7h16"/><path d="M9 7V5.5a1.5 1.5 0 0 1 1.5-1.5h3A1.5 1.5 0 0 1 15 5.5V7"/><path d="M6 7v11.5A1.5 1.5 0 0 0 7.5 20h9a1.5 1.5 0 0 0 1.5-1.5V7"/><path d="M10.5 11v5M13.5 11v5"/>',
  duplicado:
    '<rect x="8.5" y="8.5" width="12" height="12" rx="2"/><path d="M15.5 5.5H5.5a2 2 0 0 0-2 2v10"/>',
  ajustes:
    '<path d="M14.7 6.3a3.5 3.5 0 0 0 4.6 4.6l-8.6 8.6a2.4 2.4 0 0 1-3.4-3.4Z"/><path d="M6.5 4.5 9 7 7 9 4.5 6.5a2 2 0 0 1 2-2Z"/>',
  candado:
    '<rect x="4.5" y="10.5" width="15" height="9.5" rx="2"/><path d="M8 10.5V7a4 4 0 0 1 7.6-1.7"/><path d="M12 14.5v2"/>',
  hoja: '<path d="M5 19c0-7 4.5-12 14-12 0 8-4.5 12.5-11 12.5H5Z"/><path d="M9 15.5c1.5-2.5 3.5-4.2 6.5-5.5"/>',
  placas:
    '<rect x="2.5" y="6.5" width="19" height="11" rx="1.8"/><path d="M2.5 12h19"/><path d="M6 9.5h4M6 14.5h7"/>',

  // --- Interfaz ---
  check: '<path d="m4.5 12.5 5 5 10-11"/>',
  'check-circle': '<circle cx="12" cy="12" r="8.5"/><path d="m8.2 12.2 2.6 2.6 5-5.6"/>',
  /** Punto en círculo: encabeza cada grupo del desglose de precio. */
  punto: '<circle cx="12" cy="12" r="8.5"/><circle cx="12" cy="12" r="2.6" fill="currentColor" stroke="none"/>',
  'flecha-derecha': '<path d="M4 12h15"/><path d="m13 6 6 6-6 6"/>',
  chevron: '<path d="m6 9.5 6 6 6-6"/>',
  reloj: '<circle cx="12" cy="12" r="8.5"/><path d="M12 7.5V12l3 2"/>',
  escudo:
    '<path d="M12 3.5 5 6v6c0 4 3 7 7 8.5 4-1.5 7-4.5 7-8.5V6Z"/><path d="m9 12 2 2 4-4.5"/>',
  pantalla:
    '<rect x="3" y="4.5" width="18" height="12" rx="2"/><path d="M8 20h8M12 16.5V20"/>',
  euro: '<path d="M16.5 6.5A6 6 0 0 0 7 11.2v1.6a6 6 0 0 0 9.5 4.7"/><path d="M4.5 11h8M4.5 14h7"/>',
  /** Sobre y teléfono: los canales de la página de contacto. */
  sobre:
    '<rect x="3" y="5.5" width="18" height="13" rx="2"/><path d="m3.8 7.2 7.2 5.1a2 2 0 0 0 2 0l7.2-5.1"/>',
  telefono:
    '<rect x="6.5" y="2.5" width="11" height="19" rx="2.5"/><path d="M10.5 5.5h3"/><circle cx="12" cy="18" r=".7" fill="currentColor" stroke="none"/>',
  menu: '<path d="M4 7h16M4 12h16M4 17h16"/>',
  cerrar: '<path d="M6 6l12 12M18 6 6 18"/>',
  whatsapp:
    '<path d="M3.5 20.5 5 16.4A8 8 0 1 1 8.1 19.4Z"/><path d="M9 9.2c0 3 2.3 5.2 5 5.6.5.1 1-.2 1.2-.7l.2-.6a.6.6 0 0 0-.3-.7l-1.5-.7a.6.6 0 0 0-.7.2l-.4.5a4.4 4.4 0 0 1-2-2l.5-.4a.6.6 0 0 0 .2-.7l-.7-1.5a.6.6 0 0 0-.7-.3l-.6.2c-.5.2-.8.6-.7 1.1Z"/>',
  aviso:
    '<path d="M12 4.5 3 19.5h18Z"/><path d="M12 10v4"/><circle cx="12" cy="16.8" r=".7" fill="currentColor" stroke="none"/>',
} as const;

interface Props {
  name: IconName;
  /** Tamaño en píxeles. */
  size?: number;
  class?: string;
  /** Texto accesible. Si se omite, el icono se marca como decorativo. */
  label?: string;
}

const { name, size = 24, class: className, label } = Astro.props;

// Hay nombres que llegan del panel, así que el tipo no basta como garantía: un
// icono que se renombre aquí y siga guardado en el contenido caería a
// `undefined` y pintaría un SVG vacío, sin decir nada. Mejor un aviso visible.
const path = PATHS[name] ?? PATHS.aviso;
---

<svg
  xmlns="http://www.w3.org/2000/svg"
  width={size}
  height={size}
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width="1.5"
  stroke-linecap="round"
  stroke-linejoin="round"
  class={className}
  role={label ? 'img' : undefined}
  aria-label={label}
  aria-hidden={label ? undefined : 'true'}
  set:html={path}
/>
