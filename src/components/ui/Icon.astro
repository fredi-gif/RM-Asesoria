---
/**
 * Set cerrado de iconos, inline y sin dependencias. Los trazados viven en
 * `src/lib/iconos.ts`, que comparten la web y las plantillas de marca.
 */
import { PATHS, type IconName } from '../../lib/iconos';

export type { IconName };

interface Props {
  name: IconName;
  /** Tamaño en píxeles. */
  size?: number;
  class?: string;
  /** Texto accesible. Si se omite, el icono se marca como decorativo. */
  label?: string;
}

const { name, size = 24, class: className, label } = Astro.props;

// Hay nombres que llegan del panel, así que el tipo no basta como garantía: un
// icono que se renombre aquí y siga guardado en el contenido caería a
// `undefined` y pintaría un SVG vacío, sin decir nada. Mejor un aviso visible.
const path = PATHS[name] ?? PATHS.aviso;
---

<svg
  xmlns="http://www.w3.org/2000/svg"
  width={size}
  height={size}
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width="1.5"
  stroke-linecap="round"
  stroke-linejoin="round"
  class={className}
  role={label ? 'img' : undefined}
  aria-label={label}
  aria-hidden={label ? undefined : 'true'}
  set:html={path}
/>
