---
import PasoIlustracion from './PasoIlustracion.astro';

interface Props {
  numero: number;
  titulo: string;
  descripcion?: string;
  /** Explicación larga. Los saltos de línea dobles separan párrafos. */
  detalle?: string;
  ilustracion?: string;
  /** Alterna el lado de la ilustración para dar ritmo a la columna. */
  invertida?: boolean;
}

const { numero, titulo, descripcion, detalle, ilustracion, invertida = false } = Astro.props;

/**
 * Ficha de un paso: el texto a un lado y la ilustración al otro.
 *
 * En móvil no hay dos lados, así que se apila siempre en el mismo orden —
 * ilustración debajo del texto — y `invertida` deja de tener efecto: alternar
 * en vertical no aporta ritmo, solo descoloca la lectura.
 *
 * El párrafo largo se parte por líneas en blanco en vez de aceptar HTML: el
 * texto sale de Keystatic y un `set:html` ahí abriría la puerta a inyectar
 * marcado desde el panel.
 */
const parrafos = (detalle ?? '')
  .split(/\n\s*\n/)
  .map((p) => p.trim())
  .filter(Boolean);
---

<li class="grid items-center gap-8 lg:grid-cols-2 lg:gap-16">
  <div class:list={['flex flex-col gap-4', invertida && 'lg:order-2']}>
    <div class="flex items-center gap-4">
      <span
        class="flex size-12 shrink-0 items-center justify-center rounded-full bg-accent-50 font-display text-[1.125rem] font-bold text-accent-600 ring-1 ring-accent-400/25 ring-inset"
      >
        {numero}
      </span>
      <span aria-hidden="true" class="h-px flex-1 bg-line"></span>
    </div>

    <h2 class="text-h2">{titulo}</h2>

    {descripcion && <p class="max-w-[58ch] text-[1.0625rem] text-ink-muted">{descripcion}</p>}

    {
      parrafos.length > 0 && (
        <div class="flex flex-col gap-3">
          {parrafos.map((parrafo) => (
            <p class="max-w-[58ch] text-ink-muted">{parrafo}</p>
          ))}
        </div>
      )
    }
  </div>

  <!-- El panel blanco sobre el gris de la sección es lo que recorta la
       ilustración, igual que en las tarjetas de trámite. -->
  <div
    class:list={[
      'flex items-center justify-center rounded-lg border border-line bg-surface px-6 py-8',
      invertida && 'lg:order-1',
    ]}
  >
    <PasoIlustracion name={ilustracion} class="max-w-[19rem]" />
  </div>
</li>
