---
import PasoIlustracion from './PasoIlustracion.astro';

interface Props {
  titulo: string;
  descripcion?: string;
  /** Explicación larga. Los saltos de línea dobles separan párrafos. */
  detalle?: string;
  ilustracion?: string;
}

const { titulo, descripcion, detalle, ilustracion } = Astro.props;

/**
 * Contenido de un paso del proceso: el texto y su ilustración.
 *
 * El número y la línea que lo une con el paso siguiente no están aquí, los
 * pone `Proceso.astro`: son del raíl, no de la ficha, y tienen que poder
 * animarse como una sola pieza a lo largo de toda la lista.
 *
 * En móvil no hay dos lados, así que se apila en el orden de lectura —la
 * ilustración debajo del texto—, que es lo que respeta el ancho del texto.
 *
 * El párrafo largo se parte por líneas en blanco en vez de aceptar HTML: el
 * texto sale de Keystatic y un `set:html` ahí abriría la puerta a inyectar
 * marcado desde el panel.
 */
const parrafos = (detalle ?? '')
  .split(/\n\s*\n/)
  .map((p) => p.trim())
  .filter(Boolean);
---

<div class="grid items-center gap-6 lg:grid-cols-2 lg:gap-12">
  <div class="flex flex-col gap-4">
    <h2 class="text-h2">{titulo}</h2>

    {descripcion && <p class="max-w-[58ch] text-[1.0625rem] text-ink-muted">{descripcion}</p>}

    {
      parrafos.length > 0 && (
        <div class="flex flex-col gap-3">
          {parrafos.map((parrafo) => (
            <p class="max-w-[58ch] text-ink-muted">{parrafo}</p>
          ))}
        </div>
      )
    }
  </div>

  <!-- El panel blanco sobre el gris de la sección es lo que recorta la
       ilustración, igual que en las tarjetas de trámite. -->
  <div
    class="flex items-center justify-center rounded-lg border border-line bg-surface px-6 py-8"
  >
    <PasoIlustracion name={ilustracion} class="max-w-[19rem]" />
  </div>
</div>
