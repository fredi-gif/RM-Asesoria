---
/**
 * Ilustración de un paso del proceso.
 *
 * Hermana de `DocIlustracion`, pero con otro sujeto: aquella dibuja el papel
 * que hay que buscar en el cajón, esta dibuja lo que ocurre en cada fase del
 * trámite. Comparte lienzo (160×110) y paleta para que las dos familias
 * convivan sin que se note la costura.
 *
 * Los nombres son los que ofrece el select de `keystatic.config.ts`.
 */
export type PasoIlustracionName = keyof typeof ILUSTRACIONES;

const LINEA = 'var(--color-brand-100)';
const PAPEL = 'var(--color-surface)';
const TINTA = 'var(--color-brand-900)';
const ACENTO = 'var(--color-accent-500)';
const ACENTO_SUAVE = 'var(--color-accent-400)';

const ILUSTRACIONES = {
  /** Pantalla con campos y el visto bueno: rellenar el formulario. */
  formulario: `
    <rect x="26" y="18" width="108" height="74" rx="8" fill="${PAPEL}" stroke="${LINEA}" stroke-width="2"/>
    <path d="M34 18h92a8 8 0 0 1 8 8v6H26v-6a8 8 0 0 1 8-8Z" fill="${TINTA}"/>
    <circle cx="35" cy="25" r="2" fill="${PAPEL}" opacity=".45"/>
    <circle cx="42" cy="25" r="2" fill="${PAPEL}" opacity=".45"/>
    <rect x="38" y="44" width="84" height="12" rx="6" fill="var(--color-brand-50)" stroke="${LINEA}" stroke-width="1.5"/>
    <rect x="38" y="62" width="60" height="12" rx="6" fill="var(--color-brand-50)" stroke="${LINEA}" stroke-width="1.5"/>
    <path d="M46 50h26" stroke="${LINEA}" stroke-width="2.5" stroke-linecap="round"/>
    <path d="M46 68h30" stroke="${LINEA}" stroke-width="2.5" stroke-linecap="round"/>
    <circle cx="116" cy="80" r="12" fill="var(--color-accent-50)" stroke="${ACENTO_SUAVE}" stroke-width="2"/>
    <path d="m110 80 4 4 8-8" stroke="${ACENTO}" stroke-width="2.5" fill="none" stroke-linecap="round" stroke-linejoin="round"/>
  `,

  /** Móvil con un documento en pantalla y la flecha de subida: enviar papeles. */
  documentos: `
    <rect x="48" y="12" width="52" height="86" rx="9" fill="${PAPEL}" stroke="${LINEA}" stroke-width="2"/>
    <rect x="56" y="24" width="36" height="56" rx="4" fill="var(--color-brand-50)" stroke="${LINEA}" stroke-width="1.5"/>
    <path d="M63 38h22M63 48h22M63 58h12" stroke="${LINEA}" stroke-width="2.5" stroke-linecap="round"/>
    <rect x="66" y="86" width="16" height="3" rx="1.5" fill="${LINEA}"/>
    <path d="M118 76V42" stroke="${ACENTO}" stroke-width="3.5" stroke-linecap="round"/>
    <path d="m108 52 10-10 10 10" stroke="${ACENTO}" stroke-width="3.5" fill="none" stroke-linecap="round" stroke-linejoin="round"/>
    <path d="M106 88h24" stroke="${ACENTO_SUAVE}" stroke-width="3" stroke-linecap="round" opacity=".45"/>
  `,

  /** Lupa sobre el documento: la revisión previa a presentar nada. */
  revision: `
    <rect x="34" y="14" width="72" height="84" rx="7" fill="${PAPEL}" stroke="${LINEA}" stroke-width="2"/>
    <path d="M46 30h40M46 42h48M46 54h30" stroke="${LINEA}" stroke-width="3" stroke-linecap="round"/>
    <circle cx="104" cy="66" r="22" fill="var(--color-accent-50)" fill-opacity=".65" stroke="${ACENTO}" stroke-width="2.5"/>
    <path d="m120 82 13 12" stroke="${ACENTO}" stroke-width="4" stroke-linecap="round"/>
    <path d="m96 66 6 6 12-12" stroke="${ACENTO}" stroke-width="2.5" fill="none" stroke-linecap="round" stroke-linejoin="round"/>
  `,

  /** Expediente sellado: la presentación ante la administración. */
  gestion: `
    <rect x="30" y="20" width="64" height="78" rx="7" fill="var(--color-brand-50)" stroke="${LINEA}" stroke-width="2"/>
    <rect x="46" y="12" width="64" height="78" rx="7" fill="${PAPEL}" stroke="${LINEA}" stroke-width="2"/>
    <path d="M58 28h40M58 40h40M58 52h24" stroke="${LINEA}" stroke-width="3" stroke-linecap="round"/>
    <circle cx="116" cy="74" r="19" fill="none" stroke="${ACENTO}" stroke-width="2.5" opacity=".55"/>
    <circle cx="116" cy="74" r="13" fill="var(--color-accent-50)" stroke="${ACENTO_SUAVE}" stroke-width="2"/>
    <path d="m109 74 5 5 10-11" stroke="${ACENTO}" stroke-width="2.5" fill="none" stroke-linecap="round" stroke-linejoin="round"/>
  `,

  /** Tarjeta con el importe: tasas e impuestos del trámite. */
  pago: `
    <rect x="30" y="30" width="100" height="58" rx="8" fill="${PAPEL}" stroke="${LINEA}" stroke-width="2"/>
    <path d="M30 46h100" stroke="${TINTA}" stroke-width="9"/>
    <rect x="42" y="62" width="34" height="9" rx="4.5" fill="var(--color-brand-50)"/>
    <circle cx="108" cy="68" r="14" fill="var(--color-accent-50)" stroke="${ACENTO_SUAVE}" stroke-width="2"/>
    <path d="M113 62a7 7 0 1 0 0 12" fill="none" stroke="${ACENTO}" stroke-width="2.2" stroke-linecap="round"/>
    <path d="M100 66h10M100 70h10" stroke="${ACENTO}" stroke-width="2.2" stroke-linecap="round"/>
  `,

  /** Hoja con la firma trazada: la parte que firmas tú. */
  firma: `
    <rect x="42" y="14" width="76" height="84" rx="7" fill="${PAPEL}" stroke="${LINEA}" stroke-width="2"/>
    <path d="M54 30h44M54 42h52M54 52h34" stroke="${LINEA}" stroke-width="3" stroke-linecap="round"/>
    <path d="M56 80c8-12 12 7 18-2s10 6 16-6" stroke="${ACENTO}" stroke-width="2.5" fill="none" stroke-linecap="round"/>
    <path d="M54 90h48" stroke="${LINEA}" stroke-width="2" stroke-linecap="round"/>
  `,

  /** Sobre en camino: el envío de la documentación definitiva. */
  envio: `
    <rect x="42" y="28" width="88" height="60" rx="8" fill="${PAPEL}" stroke="${LINEA}" stroke-width="2"/>
    <path d="M45 35l41 27 41-27" fill="none" stroke="${LINEA}" stroke-width="2.5" stroke-linejoin="round"/>
    <path d="M14 46h18M8 60h24M18 74h14" stroke="${ACENTO_SUAVE}" stroke-width="3" stroke-linecap="round" opacity=".5"/>
    <circle cx="120" cy="80" r="12" fill="var(--color-accent-50)" stroke="${ACENTO_SUAVE}" stroke-width="2"/>
    <path d="m114 80 4 4 8-8" stroke="${ACENTO}" stroke-width="2.5" fill="none" stroke-linecap="round" stroke-linejoin="round"/>
  `,

  /** Bocadillo de conversación: el acompañamiento durante el trámite. */
  soporte: `
    <path d="M34 22h92a10 10 0 0 1 10 10v38a10 10 0 0 1-10 10H74l-20 15V80H34a10 10 0 0 1-10-10V32a10 10 0 0 1 10-10Z" fill="${PAPEL}" stroke="${LINEA}" stroke-width="2" stroke-linejoin="round"/>
    <path d="M40 42h72M40 56h48" stroke="${LINEA}" stroke-width="3" stroke-linecap="round"/>
    <circle cx="126" cy="30" r="9" fill="${ACENTO}"/>
  `,
} as const;

interface Props {
  name?: string;
  class?: string;
}

const { name = 'formulario', class: className } = Astro.props;
const arte = ILUSTRACIONES[name as PasoIlustracionName] ?? ILUSTRACIONES.formulario;
---

<svg
  viewBox="0 0 160 110"
  xmlns="http://www.w3.org/2000/svg"
  class:list={['h-auto w-full', className]}
  aria-hidden="true"
  set:html={arte}
/>
