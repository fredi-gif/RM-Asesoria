---
interface Paso {
  titulo: string;
  descripcion: string;
}

interface Props {
  pasos: Paso[];
  class?: string;
}

const { pasos, class: className } = Astro.props;
---

{
  pasos.length > 0 && (
    <ol class:list={['flex flex-col', className]}>
      {pasos.map((paso, i) => (
        <li class="relative flex gap-4 pb-8 last:pb-0">
          {/* Línea conectora: se dibuja desde el círculo hacia abajo y se
              oculta en el último paso. */}
          {i < pasos.length - 1 && (
            <span
              aria-hidden="true"
              class="absolute top-11 bottom-0 left-[1.375rem] w-px bg-line"
            />
          )}

          <span class="relative z-10 flex size-11 shrink-0 items-center justify-center rounded-full bg-accent-50 font-display text-[1.0625rem] font-bold text-accent-600 ring-1 ring-accent-400/25 ring-inset">
            {i + 1}
          </span>

          <div class="flex flex-col gap-1 pt-1.5">
            <h3 class="text-h3">{paso.titulo}</h3>
            <p class="max-w-[62ch] text-ink-muted">{paso.descripcion}</p>
          </div>
        </li>
      ))}
    </ol>
  )
}
