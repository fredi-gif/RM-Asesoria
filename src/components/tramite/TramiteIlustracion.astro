      <rect x="84" y="25" width="26" height="3.2" rx="1.6" fill="${BARRA_FUERTE}"/>
      <rect x="84" y="31" width="18" height="2.8" rx="1.4" fill="${BARRA}"/>
      <rect x="57" y="47" width="62" height="3.2" rx="1.6" fill="${BARRA}"/>
      <rect x="57" y="55" width="62" height="3.2" rx="1.6" fill="${BARRA}"/>
      <rect x="57" y="63" width="40" height="3.2" rx="1.6" fill="${BARRA}"/>
      <path d="M59 84c8-11 12 6 18-2s10 5 16-4" stroke="${NAVY}" stroke-width="2.4" fill="none" stroke-linecap="round" opacity=".75"/>
      <rect x="57" y="90" width="48" height="1.6" rx="0.8" fill="${BARRA}"/>
    </g>
    <circle cx="140" cy="74" r="26" fill="${NARANJA}"/>
    <circle cx="140" cy="74" r="26" fill="none" stroke="${NARANJA_OSCURO}" stroke-width="1.4"/>
    <path d="M149 64.5a10.5 10.5 0 0 0-16.6 8.5 10.5 10.5 0 0 0 16.6 8.5" stroke="${BLANCO}" stroke-width="4.2" fill="none" stroke-linecap="round"/>
    <path d="M128.5 70.5h14M128.5 77h12" stroke="${BLANCO}" stroke-width="3.4" stroke-linecap="round"/>
  `,

  /**
   * Liquidación del ITP: el impreso autonómico con casillas y el sello del
   * tipo impositivo. Las tres liquidaciones comparten familia y se separan
   * por el atrezzo: aquí el porcentaje, que es lo que define este impuesto.
   */
  itp: `
    ${defs}
    ${sombraMedia}
    <g transform="rotate(-7 90 56)">
      <rect x="44" y="14" width="86" height="84" rx="6" fill="${CANTO}"/>
      <rect x="44" y="10" width="86" height="84" rx="6" fill="url(#${gPapel})" stroke="${BORDE}" stroke-width="1.2"/>
      <path d="M50 10h74a6 6 0 0 1 6 6v9H44v-9a6 6 0 0 1 6-6Z" fill="url(#${gAzul})"/>
      <rect x="54" y="15" width="42" height="3" rx="1.5" fill="${BLANCO}" opacity=".8"/>
      <rect x="54" y="33" width="30" height="13" rx="2.5" fill="${BLANCO}" stroke="${BORDE}" stroke-width="1"/>
      <rect x="90" y="33" width="30" height="13" rx="2.5" fill="${BLANCO}" stroke="${BORDE}" stroke-width="1"/>
      <rect x="58" y="38" width="18" height="2.8" rx="1.4" fill="${BARRA}"/>
      <rect x="94" y="38" width="18" height="2.8" rx="1.4" fill="${BARRA}"/>
      <rect x="54" y="54" width="66" height="3.2" rx="1.6" fill="${BARRA}"/>
      <rect x="54" y="62" width="66" height="3.2" rx="1.6" fill="${BARRA}"/>
      <rect x="54" y="70" width="40" height="3.2" rx="1.6" fill="${BARRA}"/>
      <rect x="54" y="81" width="30" height="4.4" rx="2.2" fill="${BARRA_FUERTE}"/>
    </g>
    <g transform="rotate(-12 142 76)">
      <circle cx="142" cy="76" r="25" fill="${NARANJA}"/>
      <circle cx="142" cy="76" r="25" fill="none" stroke="${BLANCO}" stroke-width="2.5"/>
      <path d="m134 85 16-18" stroke="${BLANCO}" stroke-width="4" stroke-linecap="round"/>
      <circle cx="135" cy="69.5" r="4.3" fill="none" stroke="${BLANCO}" stroke-width="3.2"/>
      <circle cx="149" cy="82.5" r="4.3" fill="none" stroke="${BLANCO}" stroke-width="3.2"/>
    </g>
  `,

  /**
   * Liquidación del Impuesto de Matriculación: el modelo estatal en grafito
   * con la nube de emisiones, que es lo que fija el tramo del impuesto.
   */
  iedmt: `
    ${defs}
    ${sombraMedia}
    <g transform="rotate(-7 88 56)">
      <rect x="42" y="14" width="86" height="84" rx="6" fill="${CANTO}"/>
      <rect x="42" y="10" width="86" height="84" rx="6" fill="url(#${gPapel})" stroke="${BORDE}" stroke-width="1.2"/>
      <path d="M48 10h74a6 6 0 0 1 6 6v9H42v-9a6 6 0 0 1 6-6Z" fill="url(#${gGrafito})"/>
      <rect x="52" y="15" width="42" height="3" rx="1.5" fill="${BLANCO}" opacity=".8"/>
      <rect x="52" y="34" width="64" height="3.2" rx="1.6" fill="${BARRA}"/>
      <rect x="52" y="42" width="64" height="3.2" rx="1.6" fill="${BARRA}"/>
      <rect x="52" y="50" width="42" height="3.2" rx="1.6" fill="${BARRA}"/>
      <rect x="52" y="60" width="64" height="26" rx="3" fill="${BLANCO}" stroke="${BORDE}" stroke-width="1"/>
      <rect x="58" y="65" width="26" height="3.2" rx="1.6" fill="${BARRA}"/>
      <rect x="58" y="75" width="38" height="4.4" rx="2.2" fill="${BARRA_FUERTE}"/>
    </g>
    <path d="M120 98h32a13 13 0 0 0 1.4-25.9 17.5 17.5 0 0 0-32.9-4A12.5 12.5 0 0 0 120 98Z" fill="${GRAFITO_ITV}"/>
    <path d="M120 98h32a13 13 0 0 0 1.4-25.9 17.5 17.5 0 0 0-32.9-4A12.5 12.5 0 0 0 120 98Z" fill="none" stroke="${BLANCO}" stroke-width="2.2"/>
    <path d="M127 80h20M131 88h14" stroke="${BLANCO}" stroke-width="3.4" stroke-linecap="round" opacity=".95"/>
  `,

  /**
   * Liquidación del IVTM: el recibo municipal, con su línea de troquelado, y
   * el edificio del ayuntamiento que lo cobra.
   */
  ivtm: `
    ${defs}
    ${sombraMedia}
    <g transform="rotate(-7 82 56)">
      <rect x="44" y="16" width="74" height="82" rx="6" fill="${CANTO}"/>
      <rect x="44" y="12" width="74" height="82" rx="6" fill="url(#${gPapel})" stroke="${BORDE}" stroke-width="1.2"/>
      <path d="M50 12h62a6 6 0 0 1 6 6v9H44v-9a6 6 0 0 1 6-6Z" fill="${NAVY}"/>
      <rect x="54" y="17" width="34" height="3" rx="1.5" fill="${BLANCO}" opacity=".7"/>
      <rect x="54" y="37" width="32" height="3.4" rx="1.7" fill="${BARRA_FUERTE}"/>
      <rect x="54" y="46" width="54" height="3.2" rx="1.6" fill="${BARRA}"/>
      <rect x="54" y="54" width="54" height="3.2" rx="1.6" fill="${BARRA}"/>
      <path d="M46 66h70" stroke="${BARRA}" stroke-width="1.6" stroke-dasharray="4 3.5"/>
      <rect x="54" y="74" width="24" height="3.2" rx="1.6" fill="${BARRA}"/>
      <rect x="54" y="83" width="38" height="4.4" rx="2.2" fill="${BARRA_FUERTE}"/>
    </g>
    <path d="M132 64V52" stroke="${NARANJA_OSCURO}" stroke-width="2.6" stroke-linecap="round"/>
    <path d="M132 52h12l-3.2 3.6 3.2 3.6h-12Z" fill="${NARANJA}"/>
    <rect x="122" y="64" width="26" height="38" rx="3" fill="url(#${gAzul})"/>
    <rect x="148" y="76" width="20" height="26" rx="3" fill="${NAVY}" opacity=".8"/>
    <path d="M127 72h4M138 72h4M127 81h4M138 81h4M127 90h4M138 90h4" stroke="${BLANCO}" stroke-width="2.8" stroke-linecap="round" opacity=".85"/>
    <path d="M153 83h3.5M161 83h3.5M153 92h3.5M161 92h3.5" stroke="${BLANCO}" stroke-width="2.4" stroke-linecap="round" opacity=".65"/>
  `,

  /**
   * Genérico: el permiso, sin insignia. Es el que sale si un trámite nuevo
   * se queda con un icono para el que no hay escena propia.
   */
  coche: `
    ${defs}
    ${sombraAncha}
    ${permiso}
  `,
} as const;

interface Props {
  name?: string;
  class?: string;
}

const { name = 'coche', class: className } = Astro.props;
const arte = ILUSTRACIONES[name as TramiteIlustracionName] ?? ILUSTRACIONES.coche;
---

<svg
  viewBox="0 0 200 120"
  xmlns="http://www.w3.org/2000/svg"
  class:list={['h-auto w-full', className]}
  aria-hidden="true"
  set:html={arte}
/>
