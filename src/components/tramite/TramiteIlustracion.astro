---
/**
 * Ilustración de un trámite, para la tarjeta del listado.
 *
 * Son mock-ups de documento, no iconos: cada trámite se representa con el papel
 * que realmente se tramita —el permiso de circulación, la ficha técnica, la
 * placa, el distintivo ambiental— puesto en perspectiva ligera, con canto y
 * sombra proyectada, y acompañado del elemento de escena que da contexto (la
 * lupa, el candado, el sello).
 *
 * Cuatro reglas sostienen el conjunto:
 *
 * 1. Solo documentos. No aparece el vehículo en ninguna: lo que vendemos es la
 *    gestión del papeleo, así que el sujeto de la escena es siempre el
 *    documento. Los trámites que actúan sobre el estado del vehículo (alta,
 *    baja, cambio de servicio) se resuelven con el permiso más una insignia
 *    que dice qué le pasa.
 * 2. Perspectiva única. Todo va girado entre -5° y -11° sobre su propio centro,
 *    con el canto dibujado debajo y una sombra elíptica difuminada apoyada
 *    siempre en la misma línea de suelo (y≈104). Así los doce parecen fotos de
 *    la misma sesión y no doce dibujos sueltos.
 * 3. Color real del documento. El permiso de circulación es verde; la placa
 *    española, blanca con banda azul UE; las placas de empresa, rojas; el
 *    distintivo ambiental, azul y verde. La ficha técnica va en grafito: su
 *    color real la dejaría a un paso del verde del permiso y «Duplicado del
 *    permiso» y «Duplicado de la ficha técnica» quedan adyacentes en el
 *    listado, así que se separan por valor —neutro oscuro frente a verde— que
 *    es lo que aguanta a 120 px en móvil.
 *    La paleta de marca queda para el atrezzo (sellos, flechas, insignias),
 *    que es donde el naranja tiene que llamar la atención.
 * 4. Estructura real, texto abstracto. Se reproducen las proporciones, las
 *    bandas, las casillas y los bloques del documento, pero los renglones son
 *    barras. A 192 px de ancho —el tamaño real en la tarjeta, 120 px en móvil—
 *    cualquier texto de campo se convertiría en ruido, y además evita que el
 *    mock-up se lea como un documento oficial reproducido.
 *
 * Se indexan por el mismo nombre que el icono, así que el campo `icon` de
 * Keystatic gobierna a la vez el icono pequeño (menú, footer) y esta
 * ilustración. Añadir un trámite nuevo con un icono existente no requiere
 * dibujar nada.
 */
export type TramiteIlustracionName = keyof typeof ILUSTRACIONES;

/**
 * Los `id` de `<defs>` son globales al documento, y en el listado se pintan
 * doce de estos SVG en la misma página. Sin sufijo único, el primer degradado
 * ganaría y los once restantes heredarían sus colores.
 */
const uid = Math.random().toString(36).slice(2, 9);
const fSombra = 'sb-' + uid;
const gPapel = 'pp-' + uid;
const gPapelVerde = 'pv-' + uid;
const gAzul = 'az-' + uid;
const gVerdePermiso = 'vp-' + uid;
const gGrafito = 'gf-' + uid;
const gRojo = 'ro-' + uid;
const gCristal = 'cr-' + uid;
const gEco = 'ec-' + uid;

/* ---- Colores reales de cada documento ---- */
const AZUL_UE = '#003399'; // banda de la matrícula europea y cabecera DGT
const ORO_UE = '#ffcc00'; // estrellas
const VERDE_PERMISO = '#2e7d46'; // permiso de circulación
const GRAFITO_ITV = '#3f4d61'; // ficha técnica / tarjeta ITV
const ROJO_PLACA = '#c1272d'; // placas rojas de empresa
const ECO_AZUL = '#0e76bc'; // mitad azul del distintivo ECO
const ECO_VERDE = '#3faa49'; // mitad verde del distintivo ECO

/* ---- Neutros del papel ---- */
const CANTO = '#c3d0e0'; // grosor del documento
const CANTO_VERDE = '#b3d2bd'; // grosor del permiso, para no romper el verde
const BORDE = '#d5dfec';
const BORDE_VERDE = '#c2dcca';
const BARRA = '#c6d3e3'; // renglones abstractos
const BARRA_FUERTE = '#8fa5c0'; // renglón de titular, algo más marcado
const BARRA_VERDE = '#a9cbb3';
const BARRA_VERDE_FUERTE = '#78a386';
const HUECO_VERDE = '#e2f0e7'; // casilla de la foto del vehículo, sobre papel verde

/* ---- Marca, solo para atrezzo ---- */
const NARANJA = '#f97316';
const NARANJA_OSCURO = '#ea6a0b';
const NAVY = '#0a1f44';
const BLANCO = '#ffffff';
const VERDE_OK = '#15803d';
const ROJO_KO = '#b91c1c';
const AZUL_CLARO = '#e9f1fc'; // relleno del globo, para que no se lea como un hueco

const defs = `
  <defs>
    <filter id="${fSombra}" x="-60%" y="-120%" width="220%" height="340%">
      <feGaussianBlur stdDeviation="3.6"/>
    </filter>
    <linearGradient id="${gPapel}" x1="0" y1="0" x2="0.35" y2="1">
      <stop offset="0" stop-color="#ffffff"/>
      <stop offset="1" stop-color="#e9eff7"/>
    </linearGradient>
    <linearGradient id="${gPapelVerde}" x1="0" y1="0" x2="0.35" y2="1">
      <stop offset="0" stop-color="#fbfdfb"/>
      <stop offset="1" stop-color="#e3f0e7"/>
    </linearGradient>
    <linearGradient id="${gAzul}" x1="0" y1="0" x2="1" y2="1">
      <stop offset="0" stop-color="#0b4bb8"/>
      <stop offset="1" stop-color="${AZUL_UE}"/>
    </linearGradient>
    <linearGradient id="${gVerdePermiso}" x1="0" y1="0" x2="1" y2="1">
      <stop offset="0" stop-color="#43a05d"/>
      <stop offset="1" stop-color="${VERDE_PERMISO}"/>
    </linearGradient>
    <linearGradient id="${gGrafito}" x1="0" y1="0" x2="1" y2="1">
      <stop offset="0" stop-color="#5b6d86"/>
      <stop offset="1" stop-color="${GRAFITO_ITV}"/>
    </linearGradient>
    <linearGradient id="${gRojo}" x1="0" y1="0" x2="0.3" y2="1">
      <stop offset="0" stop-color="#d63a40"/>
      <stop offset="1" stop-color="${ROJO_PLACA}"/>
    </linearGradient>
    <linearGradient id="${gCristal}" x1="0.15" y1="0" x2="0.85" y2="1">
      <stop offset="0" stop-color="#ffffff" stop-opacity=".92"/>
      <stop offset="0.55" stop-color="#dce8f6" stop-opacity=".62"/>
      <stop offset="1" stop-color="#ffffff" stop-opacity=".85"/>
    </linearGradient>
    <linearGradient id="${gEco}" x1="0" y1="0" x2="1" y2="0">
      <stop offset="0" stop-color="${ECO_AZUL}"/>
      <stop offset="0.5" stop-color="${ECO_AZUL}"/>
      <stop offset="0.5" stop-color="${ECO_VERDE}"/>
      <stop offset="1" stop-color="${ECO_VERDE}"/>
    </linearGradient>
  </defs>
`;

/**
 * Sombras de apoyo. Van todas a la misma altura para que los doce trámites
 * compartan línea de suelo. `filter` las difumina: sin eso el mock-up parece
 * un recorte pegado.
 */
const sombraAncha = `<ellipse cx="100" cy="104" rx="60" ry="6.5" fill="${NAVY}" opacity=".18" filter="url(#${fSombra})"/>`;
const sombraMedia = `<ellipse cx="100" cy="104" rx="46" ry="5.5" fill="${NAVY}" opacity=".18" filter="url(#${fSombra})"/>`;

/**
 * Estrellas de la UE centradas en el origen, para envolver en un `translate`
 * allí donde hagan falta. Se construyen por concatenación y no con plantillas
 * anidadas: anidar backticks dentro de otra plantilla rompe el analizador del
 * frontmatter de Astro.
 */
const estrellasUE = Array.from({ length: 12 }, (_, i) => {
  const a = (i / 12) * Math.PI * 2 - Math.PI / 2;
  return (
    '<circle cx="' +
    (Math.cos(a) * 4.6).toFixed(1) +
    '" cy="' +
    (Math.sin(a) * 4.6).toFixed(1) +
    '" r="0.85" fill="' +
    ORO_UE +
    '"/>'
  );
}).join('');

/**
 * El permiso de circulación, verde, centrado y en perspectiva.
 *
 * Es la pieza que más se repite —transferencia, alta, baja, cambio de
 * servicio y el genérico— así que va como constante única: la esquina
 * superior derecha queda libre para que la insignia de cada trámite se apoye
 * encima y sea ella la que diferencia unas de otras.
 */
const permiso = `
  <g transform="rotate(-8 96 72)">
    <rect x="40" y="48" width="112" height="56" rx="7" fill="${CANTO_VERDE}"/>
    <rect x="40" y="44" width="112" height="56" rx="7" fill="url(#${gPapelVerde})" stroke="${BORDE_VERDE}" stroke-width="1.2"/>
    <path d="M47 44h98a7 7 0 0 1 7 7v9H40v-9a7 7 0 0 1 7-7Z" fill="url(#${gVerdePermiso})"/>
    <g transform="translate(53 51.5)">${estrellasUE}</g>
    <rect x="66" y="50" width="40" height="3" rx="1.5" fill="${BLANCO}" opacity=".75"/>
    <rect x="49" y="68" width="27" height="23" rx="3" fill="${HUECO_VERDE}" stroke="${BORDE_VERDE}" stroke-width="1"/>
    <path d="M54 85l6-6 4 4 5-5 4 7z" fill="${BARRA_VERDE}"/>
    <rect x="84" y="69" width="56" height="3.4" rx="1.7" fill="${BARRA_VERDE_FUERTE}"/>
    <rect x="84" y="77" width="56" height="3" rx="1.5" fill="${BARRA_VERDE}"/>
    <rect x="84" y="85" width="36" height="3" rx="1.5" fill="${BARRA_VERDE}"/>
  </g>
`;

/**
 * Insignias de estado, arriba a la derecha. Fondo y símbolo van por separado
 * para poder combinar color y signo sin anidar plantillas.
 */
const insigniaVerde = `<circle cx="150" cy="30" r="17" fill="${VERDE_OK}"/><circle cx="150" cy="30" r="17" fill="none" stroke="${BLANCO}" stroke-width="2.5"/>`;
const insigniaRoja = `<circle cx="150" cy="30" r="17" fill="${ROJO_KO}"/><circle cx="150" cy="30" r="17" fill="none" stroke="${BLANCO}" stroke-width="2.5"/>`;
const insigniaNaranja = `<circle cx="150" cy="30" r="17" fill="${NARANJA}"/><circle cx="150" cy="30" r="17" fill="none" stroke="${BLANCO}" stroke-width="2.5"/>`;
const flechaArriba = `<path d="M150 39V22m-7 7l7-7 7 7" stroke="${BLANCO}" stroke-width="3.4" fill="none" stroke-linecap="round" stroke-linejoin="round"/>`;
const flechaAbajo = `<path d="M150 21v17m-7-7l7 7 7-7" stroke="${BLANCO}" stroke-width="3.4" fill="none" stroke-linecap="round" stroke-linejoin="round"/>`;
const check = `<path d="M142 30l5.5 5.5L159 24" stroke="${BLANCO}" stroke-width="3.4" fill="none" stroke-linecap="round" stroke-linejoin="round"/>`;
const mas = `<path d="M141 30h18M150 21v18" stroke="${BLANCO}" stroke-width="3.4" stroke-linecap="round"/>`;
const intercambio = `<path d="M142 26h14m-4-4 4 4-4 4" stroke="${BLANCO}" stroke-width="2.8" fill="none" stroke-linecap="round" stroke-linejoin="round"/><path d="M158 35h-14m4 4-4-4 4-4" stroke="${BLANCO}" stroke-width="2.8" fill="none" stroke-linecap="round" stroke-linejoin="round"/>`;

const ILUSTRACIONES = {
  /** Transferencia: el permiso cambia de titular. Flechas de intercambio. */
  traspaso: `
    ${defs}
    ${sombraAncha}
    <g transform="rotate(-8 100 71)">
      <rect x="46" y="48" width="108" height="54" rx="7" fill="${CANTO_VERDE}"/>
      <rect x="46" y="44" width="108" height="54" rx="7" fill="url(#${gPapelVerde})" stroke="${BORDE_VERDE}" stroke-width="1.2"/>
      <path d="M53 44h94a7 7 0 0 1 7 7v9H46v-9a7 7 0 0 1 7-7Z" fill="url(#${gVerdePermiso})"/>
      <g transform="translate(59 51.5)">${estrellasUE}</g>
      <rect x="72" y="50" width="38" height="3" rx="1.5" fill="${BLANCO}" opacity=".75"/>
      <rect x="55" y="68" width="27" height="23" rx="3" fill="${HUECO_VERDE}" stroke="${BORDE_VERDE}" stroke-width="1"/>
      <path d="M60 85l6-6 4 4 5-5 4 7z" fill="${BARRA_VERDE}"/>
      <rect x="90" y="69" width="54" height="3.4" rx="1.7" fill="${BARRA_VERDE_FUERTE}"/>
      <rect x="90" y="77" width="54" height="3" rx="1.5" fill="${BARRA_VERDE}"/>
      <rect x="90" y="85" width="34" height="3" rx="1.5" fill="${BARRA_VERDE}"/>
    </g>
    <path d="M66 18h56" stroke="${NARANJA}" stroke-width="4" stroke-linecap="round"/>
    <path d="M114 11l8 7-8 7" stroke="${NARANJA}" stroke-width="4" fill="none" stroke-linecap="round" stroke-linejoin="round"/>
    <path d="M134 32H78" stroke="${NAVY}" stroke-width="4" stroke-linecap="round"/>
    <path d="M86 25l-8 7 8 7" stroke="${NAVY}" stroke-width="4" fill="none" stroke-linecap="round" stroke-linejoin="round"/>
  `,

  /** Notificación de venta: el impreso presentado y sellado como recibido. */
  firma: `
    ${defs}
    ${sombraMedia}
    <g transform="rotate(-7 96 60)">
      <rect x="54" y="18" width="88" height="82" rx="6" fill="${CANTO}"/>
      <rect x="54" y="14" width="88" height="82" rx="6" fill="url(#${gPapel})" stroke="${BORDE}" stroke-width="1.2"/>
      <path d="M60 14h76a6 6 0 0 1 6 6v8H54v-8a6 6 0 0 1 6-6Z" fill="url(#${gAzul})"/>
      <rect x="64" y="19" width="34" height="3" rx="1.5" fill="${BLANCO}" opacity=".8"/>
      <rect x="66" y="38" width="42" height="4" rx="2" fill="${BARRA_FUERTE}"/>
      <rect x="66" y="49" width="64" height="3.2" rx="1.6" fill="${BARRA}"/>
      <rect x="66" y="57" width="64" height="3.2" rx="1.6" fill="${BARRA}"/>
      <rect x="66" y="65" width="40" height="3.2" rx="1.6" fill="${BARRA}"/>
      <path d="M68 86c8-12 12 7 19-2s10 6 17-5" stroke="${NAVY}" stroke-width="2.6" fill="none" stroke-linecap="round" opacity=".8"/>
      <rect x="66" y="90" width="52" height="1.6" rx="0.8" fill="${BARRA}"/>
    </g>
    ${insigniaNaranja}
    ${check}
  `,

  /** Informe de DGT: el historial impreso, revisado con lupa. */
  lupa: `
    ${defs}
    ${sombraMedia}
    <g transform="rotate(-7 92 58)">
      <rect x="46" y="16" width="86" height="84" rx="6" fill="${CANTO}"/>
      <rect x="46" y="12" width="86" height="84" rx="6" fill="url(#${gPapel})" stroke="${BORDE}" stroke-width="1.2"/>
      <path d="M52 12h74a6 6 0 0 1 6 6v9H46v-9a6 6 0 0 1 6-6Z" fill="url(#${gAzul})"/>
      <g transform="translate(57 19.5)">${estrellasUE}</g>
      <rect x="70" y="18" width="42" height="3" rx="1.5" fill="${BLANCO}" opacity=".75"/>
      <rect x="57" y="38" width="38" height="4" rx="2" fill="${BARRA_FUERTE}"/>
      <rect x="57" y="49" width="64" height="3.2" rx="1.6" fill="${BARRA}"/>
      <rect x="57" y="57" width="64" height="3.2" rx="1.6" fill="${BARRA}"/>
      <rect x="57" y="65" width="64" height="3.2" rx="1.6" fill="${BARRA}"/>
      <rect x="57" y="73" width="46" height="3.2" rx="1.6" fill="${BARRA}"/>
      <rect x="57" y="81" width="30" height="3.2" rx="1.6" fill="${BARRA}"/>
    </g>
    <path d="M150 92l14 14" stroke="${NARANJA_OSCURO}" stroke-width="9" stroke-linecap="round"/>
    <circle cx="132" cy="72" r="27" fill="url(#${gCristal})"/>
    <circle cx="132" cy="72" r="27" fill="none" stroke="${NARANJA}" stroke-width="5.5"/>
    <path d="M118 60a19 19 0 0 0-6 12" stroke="${BLANCO}" stroke-width="3.4" fill="none" stroke-linecap="round" opacity=".9"/>
  `,

  /** Matriculación: la placa española recién asignada, con su sello. */
  matricula: `
    ${defs}
    ${sombraAncha}
    <g transform="rotate(-8 100 64)">
      <rect x="30" y="46" width="140" height="42" rx="6" fill="${CANTO}"/>
      <rect x="30" y="42" width="140" height="42" rx="6" fill="url(#${gPapel})" stroke="#b9c6d8" stroke-width="1.4"/>
      <path d="M36 42h14v42H36a6 6 0 0 1-6-6V48a6 6 0 0 1 6-6Z" fill="url(#${gAzul})"/>
      <g transform="translate(43 58)">${estrellasUE}</g>
      <rect x="41" y="72" width="5" height="4" rx="1" fill="${ORO_UE}"/>
      <rect x="60" y="55" width="9" height="16" rx="2" fill="#1a2433"/>
      <rect x="73" y="55" width="9" height="16" rx="2" fill="#1a2433"/>
      <rect x="86" y="55" width="9" height="16" rx="2" fill="#1a2433"/>
      <rect x="99" y="55" width="9" height="16" rx="2" fill="#1a2433"/>
      <rect x="118" y="55" width="9" height="16" rx="2" fill="#1a2433"/>
      <rect x="131" y="55" width="9" height="16" rx="2" fill="#1a2433"/>
      <rect x="144" y="55" width="9" height="16" rx="2" fill="#1a2433"/>
    </g>
    ${insigniaNaranja}
    ${check}
  `,

  /** Alta: el permiso vuelve a estar en vigor. */
  alta: `
    ${defs}
    ${sombraAncha}
    ${permiso}
    ${insigniaVerde}
    ${flechaArriba}
  `,

  /** Baja: el permiso deja de estar en vigor. */
  baja: `
    ${defs}
    ${sombraAncha}
    ${permiso}
    ${insigniaRoja}
    ${flechaAbajo}
  `,

  /** Duplicado del permiso: dos permisos, el nuevo sobre el original. */
  duplicado: `
    ${defs}
    ${sombraAncha}
    <g transform="rotate(-11 92 56)" opacity=".55">
      <rect x="34" y="30" width="106" height="56" rx="7" fill="${CANTO_VERDE}"/>
      <rect x="34" y="27" width="106" height="56" rx="7" fill="#f1f8f3" stroke="${BORDE_VERDE}" stroke-width="1.2"/>
      <path d="M41 27h92a7 7 0 0 1 7 7v9H34v-9a7 7 0 0 1 7-7Z" fill="#6fb384"/>
    </g>
    <g transform="rotate(-5 110 72)">
      <rect x="58" y="48" width="106" height="56" rx="7" fill="${CANTO_VERDE}"/>
      <rect x="58" y="44" width="106" height="56" rx="7" fill="url(#${gPapelVerde})" stroke="${BORDE_VERDE}" stroke-width="1.2"/>
      <path d="M65 44h92a7 7 0 0 1 7 7v9H58v-9a7 7 0 0 1 7-7Z" fill="url(#${gVerdePermiso})"/>
      <g transform="translate(71 51.5)">${estrellasUE}</g>
      <rect x="84" y="50" width="38" height="3" rx="1.5" fill="${BLANCO}" opacity=".75"/>
      <rect x="66" y="68" width="26" height="24" rx="3" fill="${HUECO_VERDE}" stroke="${BORDE_VERDE}" stroke-width="1"/>
      <path d="M71 85l6-6 4 4 5-5 4 7z" fill="${BARRA_VERDE}"/>
      <rect x="100" y="69" width="54" height="3.4" rx="1.7" fill="${BARRA_VERDE_FUERTE}"/>
      <rect x="100" y="77" width="54" height="3" rx="1.5" fill="${BARRA_VERDE}"/>
      <rect x="100" y="85" width="34" height="3" rx="1.5" fill="${BARRA_VERDE}"/>
    </g>
    ${insigniaNaranja}
    ${mas}
  `,

  /** Duplicado de la ficha técnica: la tarjeta ITV por duplicado. */
  documento: `
    ${defs}
    ${sombraAncha}
    <g transform="rotate(-11 92 56)" opacity=".55">
      <rect x="38" y="26" width="98" height="60" rx="7" fill="${CANTO}"/>
      <rect x="38" y="23" width="98" height="60" rx="7" fill="#f4f7fb" stroke="${BORDE}" stroke-width="1.2"/>
      <path d="M45 23h84a7 7 0 0 1 7 7v9H38v-9a7 7 0 0 1 7-7Z" fill="#8f9cb0"/>
    </g>
    <g transform="rotate(-5 110 72)">
      <rect x="62" y="46" width="98" height="60" rx="7" fill="${CANTO}"/>
      <rect x="62" y="42" width="98" height="60" rx="7" fill="url(#${gPapel})" stroke="${BORDE}" stroke-width="1.2"/>
      <path d="M69 42h84a7 7 0 0 1 7 7v9H62v-9a7 7 0 0 1 7-7Z" fill="url(#${gGrafito})"/>
      <rect x="72" y="48" width="40" height="3" rx="1.5" fill="${BLANCO}" opacity=".8"/>
      <rect x="72" y="66" width="30" height="3.4" rx="1.7" fill="${BARRA_FUERTE}"/>
      <rect x="108" y="66" width="42" height="3.4" rx="1.7" fill="${BARRA}"/>
      <rect x="72" y="75" width="30" height="3.2" rx="1.6" fill="${BARRA_FUERTE}"/>
      <rect x="108" y="75" width="42" height="3.2" rx="1.6" fill="${BARRA}"/>
      <rect x="72" y="84" width="30" height="3.2" rx="1.6" fill="${BARRA_FUERTE}"/>
      <rect x="108" y="84" width="26" height="3.2" rx="1.6" fill="${BARRA}"/>
      <circle cx="146" cy="88" r="9" fill="none" stroke="${GRAFITO_ITV}" stroke-width="1.8" opacity=".6"/>
    </g>
    ${insigniaNaranja}
    ${mas}
  `,

  /** Cambio de servicio: el permiso pasa a otro uso registrado. */
  ajustes: `
    ${defs}
    ${sombraAncha}
    ${permiso}
    ${insigniaNaranja}
    ${intercambio}
  `,

  /** Levantamiento de reserva: el contrato queda libre de cargas. */
  candado: `
    ${defs}
    ${sombraMedia}
    <g transform="rotate(-7 92 58)">
      <rect x="46" y="18" width="86" height="82" rx="6" fill="${CANTO}"/>
      <rect x="46" y="14" width="86" height="82" rx="6" fill="url(#${gPapel})" stroke="${BORDE}" stroke-width="1.2"/>
      <rect x="58" y="28" width="40" height="4" rx="2" fill="${BARRA_FUERTE}"/>
      <rect x="58" y="40" width="62" height="3.2" rx="1.6" fill="${BARRA}"/>
      <rect x="58" y="48" width="62" height="3.2" rx="1.6" fill="${BARRA}"/>
      <rect x="58" y="56" width="44" height="3.2" rx="1.6" fill="${BARRA}"/>
      <path d="M60 80c8-11 12 6 18-2s10 5 16-4" stroke="${NAVY}" stroke-width="2.4" fill="none" stroke-linecap="round" opacity=".75"/>
      <rect x="58" y="86" width="48" height="1.6" rx="0.8" fill="${BARRA}"/>
    </g>
    <path d="M124 62V50a15 15 0 0 1 29-5" fill="none" stroke="${NARANJA_OSCURO}" stroke-width="6.5" stroke-linecap="round"/>
    <rect x="110" y="60" width="56" height="42" rx="9" fill="${NARANJA}"/>
    <rect x="110" y="60" width="56" height="42" rx="9" fill="none" stroke="${NARANJA_OSCURO}" stroke-width="1.4"/>
    <circle cx="138" cy="77" r="6.5" fill="${BLANCO}"/>
    <path d="M138 83v9" stroke="${BLANCO}" stroke-width="4.6" stroke-linecap="round"/>
  `,

  /** Etiqueta medioambiental: el distintivo, como pegatina troquelada. */
  hoja: `
    ${defs}
    ${sombraMedia}
    <g transform="rotate(-8 100 60)">
      <circle cx="100" cy="64" r="40" fill="${CANTO}"/>
      <circle cx="100" cy="60" r="40" fill="url(#${gEco})"/>
      <circle cx="100" cy="60" r="40" fill="none" stroke="${BLANCO}" stroke-width="4.5"/>
      <circle cx="100" cy="60" r="31" fill="none" stroke="${BLANCO}" stroke-width="1.8" opacity=".5"/>
      <path d="M83 73c0-15 10-26 29-26 0 17-10 26-23 26z" fill="${BLANCO}" opacity=".94"/>
      <path d="M88 70c4-6 10-11 17-13" stroke="${ECO_VERDE}" stroke-width="2.1" fill="none" stroke-linecap="round"/>
      <path d="M70 40a40 40 0 0 1 23-17" stroke="${BLANCO}" stroke-width="3.2" fill="none" stroke-linecap="round" opacity=".45"/>
    </g>
  `,

  /** Placas rojas: el juego de placas temporales de empresa. */
  placas: `
    ${defs}
    ${sombraAncha}
    <g transform="rotate(-11 88 46)" opacity=".6">
      <rect x="34" y="26" width="118" height="36" rx="5" fill="#8f2429"/>
      <rect x="34" y="23" width="118" height="36" rx="5" fill="#d9565b"/>
      <rect x="52" y="36" width="76" height="10" rx="3" fill="${BLANCO}" opacity=".55"/>
    </g>
    <g transform="rotate(-5 106 76)">
      <rect x="44" y="58" width="122" height="38" rx="5" fill="#8f2429"/>
      <rect x="44" y="54" width="122" height="38" rx="5" fill="url(#${gRojo})"/>
      <rect x="44" y="54" width="122" height="38" rx="5" fill="none" stroke="#a51f25" stroke-width="1.2"/>
      <rect x="53" y="66" width="8" height="15" rx="2" fill="${BLANCO}"/>
      <rect x="70" y="66" width="8" height="15" rx="2" fill="${BLANCO}"/>
      <rect x="82" y="66" width="8" height="15" rx="2" fill="${BLANCO}"/>
      <rect x="94" y="66" width="8" height="15" rx="2" fill="${BLANCO}"/>
      <rect x="112" y="66" width="8" height="15" rx="2" fill="${BLANCO}"/>
      <rect x="124" y="66" width="8" height="15" rx="2" fill="${BLANCO}"/>
      <rect x="136" y="66" width="8" height="15" rx="2" fill="${BLANCO}"/>
      <rect x="148" y="66" width="8" height="15" rx="2" fill="${BLANCO}"/>
    </g>
  `,

  /**
   * Entrega a compraventa: el permiso con la etiqueta de stock colgando. El
   * coche queda en depósito del profesional, no cambia de dueño — de ahí la
   * etiqueta y no una insignia de estado.
   */
  entrega: `
    ${defs}
    ${sombraAncha}
    ${permiso}
    <path d="M138 42c5-9 10-14 16-17" stroke="${NAVY}" stroke-width="2" fill="none" stroke-linecap="round" opacity=".5"/>
    <g transform="rotate(14 152 24)">
      <path d="M140 12h24a5 5 0 0 1 5 5v10a5 5 0 0 1-5 5h-24l-9-10z" fill="${NARANJA}"/>
      <path d="M140 12h24a5 5 0 0 1 5 5v10a5 5 0 0 1-5 5h-24l-9-10z" fill="none" stroke="${NARANJA_OSCURO}" stroke-width="1.2" stroke-linejoin="round"/>
      <circle cx="138.5" cy="22" r="2.6" fill="${BLANCO}"/>
      <rect x="146" y="17.5" width="17" height="2.8" rx="1.4" fill="${BLANCO}" opacity=".92"/>
      <rect x="146" y="23.5" width="11" height="2.8" rx="1.4" fill="${BLANCO}" opacity=".62"/>
    </g>
  `,

  /**
   * Finalización de la entrega: el contrato cerrado y sellado. Se separa del
   * resto de la familia verde por el sello grande, que es lo que se lee a
   * 120 px, no una insignia más en la esquina.
   */
  finalizacion: `
    ${defs}
    ${sombraMedia}
    <g transform="rotate(-7 92 58)">
      <rect x="46" y="16" width="86" height="84" rx="6" fill="${CANTO}"/>
      <rect x="46" y="12" width="86" height="84" rx="6" fill="url(#${gPapel})" stroke="${BORDE}" stroke-width="1.2"/>
      <path d="M52 12h74a6 6 0 0 1 6 6v8H46v-8a6 6 0 0 1 6-6Z" fill="url(#${gVerdePermiso})"/>
      <rect x="58" y="16" width="36" height="3" rx="1.5" fill="${BLANCO}" opacity=".8"/>
      <rect x="57" y="36" width="40" height="4" rx="2" fill="${BARRA_FUERTE}"/>
      <rect x="57" y="47" width="62" height="3.2" rx="1.6" fill="${BARRA}"/>
      <rect x="57" y="55" width="62" height="3.2" rx="1.6" fill="${BARRA}"/>
      <rect x="57" y="63" width="42" height="3.2" rx="1.6" fill="${BARRA}"/>
      <path d="M59 84c8-12 12 7 19-2s10 6 17-5" stroke="${NAVY}" stroke-width="2.6" fill="none" stroke-linecap="round" opacity=".8"/>
      <rect x="57" y="89" width="50" height="1.6" rx="0.8" fill="${BARRA}"/>
    </g>
    <g transform="rotate(-12 138 74)">
      <circle cx="138" cy="74" r="26" fill="${BLANCO}" opacity=".55"/>
      <circle cx="138" cy="74" r="26" fill="none" stroke="${VERDE_OK}" stroke-width="5"/>
      <circle cx="138" cy="74" r="19" fill="none" stroke="${VERDE_OK}" stroke-width="1.8" opacity=".5"/>
      <path d="M129 74.5l6.5 6.5L147 68" stroke="${VERDE_OK}" stroke-width="5.2" fill="none" stroke-linecap="round" stroke-linejoin="round"/>
    </g>
  `,

  /**
   * Notificación a compraventa: el impreso que se cursa, con la campana como
   * atrezzo. La campana va grande y no como insignia para no confundirse con
   * la notificación de venta, que comparte impreso azul.
   */
  campana: `
    ${defs}
    ${sombraMedia}
    <g transform="rotate(-7 90 56)">
      <rect x="44" y="16" width="84" height="82" rx="6" fill="${CANTO}"/>
      <rect x="44" y="12" width="84" height="82" rx="6" fill="url(#${gPapel})" stroke="${BORDE}" stroke-width="1.2"/>
      <path d="M50 12h72a6 6 0 0 1 6 6v9H44v-9a6 6 0 0 1 6-6Z" fill="url(#${gAzul})"/>
      <g transform="translate(55 19.5)">${estrellasUE}</g>
      <rect x="68" y="18" width="40" height="3" rx="1.5" fill="${BLANCO}" opacity=".75"/>
      <rect x="55" y="38" width="34" height="4" rx="2" fill="${BARRA_FUERTE}"/>
      <rect x="55" y="49" width="58" height="3.2" rx="1.6" fill="${BARRA}"/>
      <rect x="55" y="57" width="58" height="3.2" rx="1.6" fill="${BARRA}"/>
      <rect x="55" y="65" width="58" height="3.2" rx="1.6" fill="${BARRA}"/>
      <rect x="55" y="73" width="36" height="3.2" rx="1.6" fill="${BARRA}"/>
    </g>
    <path d="M140 62v5" stroke="${NARANJA_OSCURO}" stroke-width="3.6" stroke-linecap="round"/>
    <path d="M122 85a18 18 0 0 1 36 0v6l4 8h-44l4-8Z" fill="${NARANJA}"/>
    <path d="M122 85a18 18 0 0 1 36 0v6l4 8h-44l4-8Z" fill="none" stroke="${NARANJA_OSCURO}" stroke-width="1.4" stroke-linejoin="round"/>
    <path d="M134 99a6 6 0 0 0 12 0Z" fill="${NARANJA_OSCURO}"/>
  `,

  /**
   * Importación: la ficha técnica extranjera, en grafito, con el globo al
   * lado. El documento sigue siendo el sujeto; el globo dice de dónde viene.
   */
  globo: `
    ${defs}
    ${sombraMedia}
    <g transform="rotate(-7 88 56)">
      <rect x="42" y="16" width="84" height="82" rx="6" fill="${CANTO}"/>
      <rect x="42" y="12" width="84" height="82" rx="6" fill="url(#${gPapel})" stroke="${BORDE}" stroke-width="1.2"/>
      <path d="M48 12h72a6 6 0 0 1 6 6v9H42v-9a6 6 0 0 1 6-6Z" fill="url(#${gGrafito})"/>
      <rect x="52" y="17" width="44" height="3" rx="1.5" fill="${BLANCO}" opacity=".8"/>
      <rect x="52" y="37" width="28" height="3.4" rx="1.7" fill="${BARRA_FUERTE}"/>
      <rect x="86" y="37" width="30" height="3.4" rx="1.7" fill="${BARRA}"/>
      <rect x="52" y="46" width="28" height="3.2" rx="1.6" fill="${BARRA_FUERTE}"/>
      <rect x="86" y="46" width="30" height="3.2" rx="1.6" fill="${BARRA}"/>
      <rect x="52" y="55" width="28" height="3.2" rx="1.6" fill="${BARRA_FUERTE}"/>
      <rect x="86" y="55" width="22" height="3.2" rx="1.6" fill="${BARRA}"/>
      <rect x="52" y="70" width="30" height="4" rx="2" fill="${BARRA_FUERTE}"/>
    </g>
    <circle cx="138" cy="72" r="26" fill="${AZUL_CLARO}"/>
    <circle cx="138" cy="72" r="26" fill="none" stroke="${AZUL_UE}" stroke-width="4.5"/>
    <path d="M112 72h52" stroke="${AZUL_UE}" stroke-width="2.8"/>
    <path d="M116 60h44M116 84h44" stroke="${AZUL_UE}" stroke-width="2" opacity=".5"/>
    <path d="M138 46c6.6 7.2 10.2 16.1 10.2 26s-3.6 18.8-10.2 26c-6.6-7.2-10.2-16.1-10.2-26s3.6-18.8 10.2-26Z" fill="none" stroke="${AZUL_UE}" stroke-width="2.8"/>
  `,

  /**
   * Carta de pago: la carta de la financiera, con membrete en vez de banda a
   * todo el ancho —no es un impreso oficial— y el sello de pagado.
   */
  'carta-pago': `
    ${defs}
    ${sombraMedia}
    <g transform="rotate(-7 92 58)">
      <rect x="46" y="16" width="86" height="84" rx="6" fill="${CANTO}"/>
      <rect x="46" y="12" width="86" height="84" rx="6" fill="url(#${gPapel})" stroke="${BORDE}" stroke-width="1.2"/>
