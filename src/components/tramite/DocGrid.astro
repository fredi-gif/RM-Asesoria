---
import Card from '../ui/Card.astro';
import DocIlustracion from './DocIlustracion.astro';

/**
 * Rejilla plana con toda la documentación del trámite.
 *
 * Deliberadamente sin agrupar por casos: el usuario ve de una vez todo lo que
 * tiene que reunir. Los matices («solo si vende una empresa») van en la
 * aclaración de cada documento, no en la estructura.
 */
interface Props {
  documentos: { documento: string; ayuda?: string | null; ilustracion?: string | null }[];
  class?: string;
}

const { documentos, class: className } = Astro.props;

/**
 * Dos columnas siempre, también en móvil.
 *
 * La rejilla vive ahora en la columna de contenido, no a todo el ancho de la
 * página. Con cuatro columnas las tarjetas se quedaban en 190px, y con tres en
 * 240px: la aclaración de cada documento caía a renglones de 28 caracteres. A
 * dos columnas son ~370px y el texto respira.
 *
 * En móvil también van a dos: a una columna la lista se hacía kilométrica y
 * había que scrollear mucho para ver cuántos documentos son. A cambio, la
 * caja se aprieta —menos padding y un escalón menos de texto— hasta el
 * `sm`, donde recupera la holgura de escritorio.
 */
---

{
  documentos.length > 0 && (
    <ul class:list={['grid grid-cols-2 gap-3 sm:gap-4', className]}>
      {documentos.map((doc) => (
        // Gris la tarjeta y blanco el panel de la ilustración, como en las
        // tarjetas de la home: es lo que las recorta sobre el fondo blanco.
        <Card as="li" tone="muted" class="flex flex-col overflow-hidden">
          <div class="border-b border-line bg-surface px-4 pt-4 pb-0 sm:px-6 sm:pt-5">
            <DocIlustracion
              name={doc.ilustracion ?? 'generico'}
              class="mx-auto max-w-[9rem] sm:max-w-[13rem]"
            />
          </div>
          <div class="flex flex-col gap-1 p-4 sm:p-5">
            <h3 class="font-display text-small font-semibold text-brand-900 sm:text-body">
              {doc.documento}
            </h3>
            {doc.ayuda && <p class="text-caption text-ink-muted sm:text-small">{doc.ayuda}</p>}
          </div>
        </Card>
      ))}
    </ul>
  )
}
