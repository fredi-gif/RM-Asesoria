---
import Icon from '../ui/Icon.astro';

interface Props {
  faqs: { pregunta: string; respuesta: string }[];
  /**
   * Pregunta que encabeza el bloque. Su respuesta llega por el slot
   * `destacada`, así que admite texto con formato y enlaces internos.
   * Se publica abierta: es la explicación de qué es el trámite.
   */
  preguntaDestacada?: string | null;
  class?: string;
}

const { faqs, preguntaDestacada, class: className } = Astro.props;
const tieneDestacada = Boolean(preguntaDestacada) && Astro.slots.has('destacada');

/**
 * `<details>`/`<summary>` nativos: cero JavaScript, funciona sin hidratación,
 * y el contenido es visible para el buscador aunque esté plegado.
 */
const summary =
  'flex cursor-pointer list-none items-start justify-between gap-4 py-4 font-display font-semibold text-brand-900 [&::-webkit-details-marker]:hidden';
const chevron =
  'mt-0.5 shrink-0 text-ink-subtle transition-transform duration-200 group-open:-rotate-180';
---

{
  (tieneDestacada || faqs.length > 0) && (
    <div class:list={['flex flex-col divide-y divide-line border-y border-line', className]}>
      {tieneDestacada && (
        <details class="group" open>
          <summary class={summary}>
            {preguntaDestacada}
            <Icon name="chevron" size={20} class={chevron} />
          </summary>
          <div class="pb-5">
            <slot name="destacada" />
          </div>
        </details>
      )}

      {faqs.map((faq) => (
        <details class="group">
          <summary class={summary}>
            {faq.pregunta}
            <Icon name="chevron" size={20} class={chevron} />
          </summary>
          <p class="max-w-[68ch] pb-5 text-ink-muted">{faq.respuesta}</p>
        </details>
      ))}
    </div>
  )
}
