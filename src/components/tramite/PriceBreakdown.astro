---
import Card from '../ui/Card.astro';
import Icon from '../ui/Icon.astro';
import WhatsAppCTA from './WhatsAppCTA.astro';
import ImportePerfil from './ImportePerfil.astro';
import PerfilSwitch from './PerfilSwitch.astro';
import { honorariosPerfil, totalTramite, type Tramite } from '../../lib/tramites';

interface Props {
  precio: Tramite['data']['precio'];
  /** Plazo de tramitación. Va aquí, junto al precio, donde se decide la compra. */
  plazo?: string | null;
  /**
   * Si se pasa, el botón se pinta dentro de la tarjeta y a todo el ancho.
   * Se omite en la cabecera, que ya tiene su propio CTA bajo el H1.
   */
  cta?: { mensaje: string; label: string } | null;
  /** `glass` para que se transparente el fondo desenfocado de la cabecera. */
  tone?: 'white' | 'glass';
  class?: string;
}

const { precio, plazo, cta = null, tone = 'white', class: className } = Astro.props;

/** Tipo general de IVA aplicable a los servicios de gestoría. */
const IVA = 0.21;

/**
 * `honorarios` se guarda con el IVA ya sumado, así que la base y la cuota se
 * derivan de ahí. Se redondea la base y la cuota se calcula por diferencia,
 * de modo que las dos líneas suman siempre exactamente los honorarios.
 */
function desglosar(honorarios: number) {
  const base = Math.round((honorarios / (1 + IVA)) * 100) / 100;
  return { base, iva: Math.round((honorarios - base) * 100) / 100 };
}

/**
 * La tarjeta trae el desglose de los dos perfiles y el CSS enseña el del que
 * esté activo. La tasa de la DGT es un tributo y no cambia de un perfil a otro.
 */
const particular = desglosar(honorariosPerfil(precio, 'particular'));
const profesional = desglosar(honorariosPerfil(precio, 'profesional'));

/** Conceptos cerrados, los que componen el total. */
const incluido = [
  {
    concepto: 'Nuestro servicio',
    detalle: 'base imponible',
    particular: particular.base,
    profesional: profesional.base,
  },
  {
    concepto: `IVA (${IVA * 100} %)`,
    detalle: 'sobre nuestro servicio',
    particular: particular.iva,
    profesional: profesional.iva,
  },
  ...(precio.tasaDgt !== null
    ? [
        {
          concepto: 'Tasa DGT',
          detalle: 'no sujeta a IVA',
          particular: precio.tasaDgt,
          profesional: precio.tasaDgt,
        },
      ]
    : []),
];

const grupoTitulo =
  'flex items-center gap-2 font-display text-small font-semibold text-brand-900';
---

<Card tone={tone} class:list={['flex flex-col overflow-hidden', className]}>
  <div class="flex flex-col gap-6 p-6">
    <!-- El selector también aquí, no solo en la home: hay tráfico que entra
         directo a la ficha desde el buscador y un profesional tiene que poder
         ver su tarifa sin volver a la portada. -->
    <PerfilSwitch size="sm" fullWidth />

    <!-- Precio destacado. La cifra y el «€» van separados para poder darles
         tamaños distintos, como el «$299/month» de la referencia pero con el
         símbolo detrás, que es como se escribe en castellano. -->
    <div class="flex flex-col gap-1.5">
      {
        precio.mostrarDesde && (
          <span class="font-display text-caption font-bold tracking-[0.14em] text-accent-600 uppercase">
            Desde
          </span>
        )
      }
      <p class="flex items-baseline gap-1.5">
        <ImportePerfil
          particular={totalTramite(precio, 'particular')}
          profesional={totalTramite(precio, 'profesional')}
          formato="numero"
          class="font-display text-[3.25rem] leading-none font-bold tracking-[-0.03em] text-brand-900 tabular-nums"
        />
        <span class="font-display text-h3 font-bold text-ink-subtle">€</span>
      </p>
      {
        plazo && (
          <p class="flex items-center gap-1.5 text-small text-ink-muted">
            <Icon name="reloj" size={15} class="shrink-0 text-accent-500" />
            Listo en <strong class="font-semibold text-brand-900">{plazo}</strong>
          </p>
        )
      }
    </div>

    <div class="h-px bg-line"></div>

    <div class="flex flex-col gap-5">
      <div class="flex flex-col gap-2.5">
        <h3 class={grupoTitulo}>
          <Icon name="punto" size={17} class="shrink-0 text-accent-500" />
          Qué incluye este precio
        </h3>
        <ul class="flex flex-col gap-2 pl-[1.6rem]">
          {
            /* Concepto y matiz apilados, no en la misma línea: en la tarjeta
               estrecha de la cabecera el «· IVA incluido» partía el renglón y
               dejaba el importe descolgado del texto. */
            incluido.map((linea) => (
              <li class="flex items-start justify-between gap-3">
                <span class="flex items-start gap-2">
                  <Icon name="check" size={14} class="mt-1 shrink-0 text-accent-500" />
                  <span class="flex flex-col">
                    <span class="text-small text-ink">{linea.concepto}</span>
                    <span class="text-caption text-ink-subtle">{linea.detalle}</span>
                  </span>
                </span>
                <ImportePerfil
                  particular={linea.particular}
                  profesional={linea.profesional}
                  class="shrink-0 font-display text-small font-semibold text-brand-900 tabular-nums"
                />
              </li>
            ))
          }
        </ul>
      </div>

      {
        precio.notas.length > 0 && (
          <div class="flex flex-col gap-2.5">
            <h3 class={grupoTitulo}>
              <Icon name="punto" size={17} class="shrink-0 text-ink-subtle" />
              Aparte, según tu caso
            </h3>
            <ul class="flex flex-col gap-2 pl-[1.6rem]">
              {precio.notas.map((nota) => (
                <li class="flex items-baseline justify-between gap-3 text-small">
                  <span class="text-ink-muted">{nota}</span>
                  <span class="shrink-0 text-caption text-ink-subtle">Variable</span>
                </li>
              ))}
            </ul>
          </div>
        )
      }
    </div>

    {
      cta && (
        <div class="flex flex-col gap-2">
          <WhatsAppCTA mensaje={cta.mensaje} label={cta.label} fullWidth />
          <p class="text-center text-caption text-ink-subtle">
            Te confirmamos el importe exacto antes de tramitar nada.
          </p>
        </div>
      )
    }
  </div>
</Card>
