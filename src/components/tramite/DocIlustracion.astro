---
/**
 * Ilustración de un tipo de documento.
 *
 * Son representaciones estilizadas, no reproducciones: la idea es que el
 * usuario reconozca de un vistazo qué papel tiene que buscar en el cajón,
 * no que se parezca al documento oficial.
 *
 * Los nombres son los que ofrece el select de `keystatic.config.ts`.
 */
export type IlustracionName = keyof typeof ILUSTRACIONES;

const LINEA = 'var(--color-brand-100)';
const PAPEL = 'var(--color-surface)';
const TINTA = 'var(--color-brand-900)';
const ACENTO = 'var(--color-accent-500)';
const ACENTO_SUAVE = 'var(--color-accent-400)';

// Círculo de estrellas de la UE para el certificado de conformidad.
const estrellasUE = Array.from({ length: 10 }, (_, i) => {
  const a = (i / 10) * Math.PI * 2 - Math.PI / 2;
  return `<circle cx="${(80 + Math.cos(a) * 11).toFixed(1)}" cy="${(46 + Math.sin(a) * 11).toFixed(1)}" r="1.6" fill="${PAPEL}"/>`;
}).join('');

const ILUSTRACIONES = {
  /** Tarjeta apaisada con banda superior: el permiso de circulación. */
  'permiso-circulacion': `
    <rect x="24" y="28" width="112" height="58" rx="7" fill="${PAPEL}" stroke="${LINEA}" stroke-width="2"/>
    <path d="M31 28h98a7 7 0 0 1 7 7v8H24v-8a7 7 0 0 1 7-7Z" fill="${TINTA}"/>
    <rect x="34" y="52" width="32" height="26" rx="3" fill="var(--color-brand-50)" stroke="${LINEA}" stroke-width="1.5"/>
    <path d="M76 56h50M76 65h50M76 74h30" stroke="${LINEA}" stroke-width="3" stroke-linecap="round"/>
  `,

  /** Tarjeta con filas de datos y el sello de la inspección. */
  'ficha-tecnica': `
    <rect x="30" y="20" width="100" height="72" rx="7" fill="${PAPEL}" stroke="${LINEA}" stroke-width="2"/>
    <path d="M42 34h44" stroke="${TINTA}" stroke-width="3.5" stroke-linecap="round"/>
    <path d="M42 46h60M42 56h60M42 66h38" stroke="${LINEA}" stroke-width="3" stroke-linecap="round"/>
    <circle cx="104" cy="72" r="12" fill="none" stroke="${ACENTO_SUAVE}" stroke-width="2"/>
    <path d="M97 72h14" stroke="${ACENTO_SUAVE}" stroke-width="2" stroke-linecap="round"/>
  `,

  /** Documento de identidad: foto, datos y chip. */
  dni: `
    <rect x="24" y="30" width="112" height="54" rx="7" fill="${PAPEL}" stroke="${LINEA}" stroke-width="2"/>
    <rect x="34" y="40" width="28" height="34" rx="4" fill="var(--color-brand-50)"/>
    <circle cx="48" cy="52" r="6" fill="${LINEA}"/>
    <path d="M38 70a10 10 0 0 1 20 0Z" fill="${LINEA}"/>
    <path d="M72 46h50M72 56h34" stroke="${LINEA}" stroke-width="3.5" stroke-linecap="round"/>
    <rect x="72" y="64" width="20" height="14" rx="3" fill="${ACENTO_SUAVE}" opacity=".45"/>
  `,

  /** Hoja con firma manuscrita: contratos de compraventa. */
  contrato: `
    <rect x="42" y="14" width="76" height="84" rx="7" fill="${PAPEL}" stroke="${LINEA}" stroke-width="2"/>
    <path d="M54 30h38" stroke="${TINTA}" stroke-width="3.5" stroke-linecap="round"/>
    <path d="M54 42h52M54 52h52M54 62h34" stroke="${LINEA}" stroke-width="3" stroke-linecap="round"/>
    <path d="M56 82c7-11 11 6 17-2s9 5 15-5" stroke="${ACENTO}" stroke-width="2.5" fill="none" stroke-linecap="round"/>
    <path d="M54 90h44" stroke="${LINEA}" stroke-width="2" stroke-linecap="round"/>
  `,

  /** Hoja con líneas de concepto y el importe destacado. */
  factura: `
    <rect x="42" y="14" width="76" height="84" rx="7" fill="${PAPEL}" stroke="${LINEA}" stroke-width="2"/>
    <path d="M54 30h30" stroke="${TINTA}" stroke-width="3.5" stroke-linecap="round"/>
    <path d="M54 44h52M54 54h52M54 64h52" stroke="${LINEA}" stroke-width="3" stroke-linecap="round"/>
    <rect x="76" y="76" width="30" height="13" rx="4" fill="${ACENTO_SUAVE}" opacity=".45"/>
  `,

  /** Hoja con sello circular: denuncias y documentos policiales. */
  denuncia: `
    <rect x="42" y="14" width="76" height="84" rx="7" fill="${PAPEL}" stroke="${LINEA}" stroke-width="2"/>
    <path d="M54 30h44M54 42h52M54 52h34" stroke="${LINEA}" stroke-width="3" stroke-linecap="round"/>
    <circle cx="94" cy="74" r="17" fill="none" stroke="${ACENTO}" stroke-width="2.5" opacity=".65"/>
    <circle cx="94" cy="74" r="11" fill="none" stroke="${ACENTO}" stroke-width="1.5" opacity=".45"/>
    <path d="M88 74h12" stroke="${ACENTO}" stroke-width="2" stroke-linecap="round" opacity=".65"/>
  `,

  /** Hoja con sello y lazo: certificados de cancelación o destrucción. */
  certificado: `
    <rect x="42" y="14" width="76" height="84" rx="7" fill="${PAPEL}" stroke="${LINEA}" stroke-width="2"/>
    <path d="M54 30h52M54 40h52M54 50h36" stroke="${LINEA}" stroke-width="3" stroke-linecap="round"/>
    <path d="m74 78-5 16 11-6 11 6-5-16" fill="${ACENTO_SUAVE}" opacity=".5"/>
    <circle cx="80" cy="72" r="13" fill="var(--color-accent-50)" stroke="${ACENTO_SUAVE}" stroke-width="2"/>
    <path d="m74 72 4 4 9-9" stroke="${ACENTO}" stroke-width="2.5" fill="none" stroke-linecap="round" stroke-linejoin="round"/>
  `,

  /** Recibo con el borde dentado: justificantes de pago. */
  justificante: `
    <path d="M50 16h60v76l-8-5-7 5-8-5-7 5-8-5-7 5-8-5Z" fill="${PAPEL}" stroke="${LINEA}" stroke-width="2" stroke-linejoin="round"/>
    <path d="M60 34h40M60 46h40M60 58h24" stroke="${LINEA}" stroke-width="3" stroke-linecap="round"/>
    <path d="M60 70h22" stroke="${ACENTO}" stroke-width="3.5" stroke-linecap="round"/>
  `,

  /** Placa de matrícula con la banda azul europea. */
  matricula: `
    <rect x="20" y="38" width="120" height="34" rx="5" fill="${PAPEL}" stroke="${LINEA}" stroke-width="2"/>
    <path d="M25 38h14v34H25a5 5 0 0 1-5-5V43a5 5 0 0 1 5-5Z" fill="${TINTA}"/>
    <circle cx="32" cy="51" r="4.5" fill="none" stroke="${ACENTO_SUAVE}" stroke-width="1.5"/>
    <path d="M50 55h20M78 55h34" stroke="${TINTA}" stroke-width="7" stroke-linecap="round" opacity=".8"/>
  `,

  /** Dos hojas superpuestas con sello: escrituras y poderes. */
  escritura: `
    <rect x="34" y="20" width="70" height="78" rx="7" fill="var(--color-brand-50)" stroke="${LINEA}" stroke-width="2"/>
    <rect x="50" y="12" width="70" height="78" rx="7" fill="${PAPEL}" stroke="${LINEA}" stroke-width="2"/>
    <path d="M62 30h46M62 40h46M62 50h30" stroke="${LINEA}" stroke-width="3" stroke-linecap="round"/>
    <circle cx="98" cy="72" r="13" fill="var(--color-accent-50)" stroke="${ACENTO_SUAVE}" stroke-width="2"/>
    <path d="M98 65v14M91 72h14" stroke="${ACENTO}" stroke-width="2" stroke-linecap="round"/>
  `,

  /** Hoja con el círculo de estrellas europeo: certificado de conformidad. */
  coc: `
    <rect x="42" y="14" width="76" height="84" rx="7" fill="${PAPEL}" stroke="${LINEA}" stroke-width="2"/>
    <circle cx="80" cy="46" r="17" fill="${TINTA}"/>
    ${estrellasUE}
    <path d="M54 76h52M54 86h34" stroke="${LINEA}" stroke-width="3" stroke-linecap="round"/>
  `,

  /** Escudo sobre la póliza: seguros. */
  seguro: `
    <rect x="42" y="14" width="76" height="84" rx="7" fill="${PAPEL}" stroke="${LINEA}" stroke-width="2"/>
    <path d="M54 28h32" stroke="${LINEA}" stroke-width="3" stroke-linecap="round"/>
    <path d="M80 40l21 7v15c0 13-9 21-21 25-12-4-21-12-21-25V47Z" fill="var(--color-brand-50)" stroke="${LINEA}" stroke-width="2"/>
    <path d="m72 66 6 6 13-14" stroke="${ACENTO}" stroke-width="3" fill="none" stroke-linecap="round" stroke-linejoin="round"/>
  `,

  /** Campos de formulario: datos que nos tienes que dar, no papeles. */
  datos: `
    <rect x="30" y="22" width="100" height="66" rx="7" fill="${PAPEL}" stroke="${LINEA}" stroke-width="2"/>
    <rect x="44" y="36" width="72" height="12" rx="6" fill="var(--color-brand-50)" stroke="${LINEA}" stroke-width="1.5"/>
    <rect x="44" y="58" width="72" height="12" rx="6" fill="var(--color-brand-50)" stroke="${LINEA}" stroke-width="1.5"/>
    <path d="M53 42h18" stroke="${ACENTO}" stroke-width="2.5" stroke-linecap="round"/>
    <path d="M53 64h32" stroke="${LINEA}" stroke-width="2.5" stroke-linecap="round"/>
  `,

  /** Hoja con la esquina doblada: cualquier otro documento. */
  generico: `
    <path d="M50 14h34l28 28v50a7 7 0 0 1-7 7H50a7 7 0 0 1-7-7V21a7 7 0 0 1 7-7Z" fill="${PAPEL}" stroke="${LINEA}" stroke-width="2" stroke-linejoin="round"/>
    <path d="M84 14v28h28" fill="none" stroke="${LINEA}" stroke-width="2" stroke-linejoin="round"/>
    <path d="M56 58h40M56 70h40M56 82h22" stroke="${LINEA}" stroke-width="3" stroke-linecap="round"/>
  `,
} as const;

interface Props {
  name?: string;
  class?: string;
}

const { name = 'generico', class: className } = Astro.props;
const arte = ILUSTRACIONES[name as IlustracionName] ?? ILUSTRACIONES.generico;
---

<svg
  viewBox="0 0 160 110"
  xmlns="http://www.w3.org/2000/svg"
  class:list={['h-auto w-full', className]}
  aria-hidden="true"
  set:html={arte}
/>
