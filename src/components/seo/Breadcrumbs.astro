---
import Icon from '../ui/Icon.astro';

interface Props {
  /** Sin incluir «Inicio», que se añade siempre. */
  items: { label: string; href: string }[];
  class?: string;
}

const { items, class: className } = Astro.props;
const todos = [{ label: 'Inicio', href: '/' }, ...items];
---

<nav aria-label="Migas de pan" class={className}>
  <ol class="flex flex-wrap items-center gap-1.5 text-caption text-ink-muted">
    {
      todos.map((item, i) => (
        <li class="flex items-center gap-1.5">
          {i > 0 && (
            <Icon name="chevron" size={13} class="-rotate-90 text-ink-subtle" />
          )}
          {i === todos.length - 1 ? (
            <span aria-current="page" class="font-semibold text-brand-900">
              {item.label}
            </span>
          ) : (
            <a href={item.href} class="transition-colors hover:text-accent-600">
              {item.label}
            </a>
          )}
        </li>
      ))
    }
  </ol>
</nav>
