---
import { empresa } from '../../lib/config';

/**
 * ⚠️ LOGO PROVISIONAL — monograma + wordmark generados con los tokens de marca.
 * Cuando llegue el logo real del cliente, sustituye el contenido del <svg>
 * (o cámbialo por un <img> al SVG definitivo) sin tocar nada más.
 */
interface Props {
  /** Versión para fondos oscuros (footer). */
  inverse?: boolean;
  class?: string;
}

const { inverse = false, class: className } = Astro.props;

const marca = inverse ? '#ffffff' : 'var(--color-brand-900)';
---

<span class:list={['inline-flex items-center gap-2.5', className]}>
  <svg width="34" height="34" viewBox="0 0 34 34" fill="none" aria-hidden="true">
    <rect width="34" height="34" rx="9" fill={marca}></rect>
    <path
      d="M9.4 24V10.2h5.35c2.9 0 4.55 1.55 4.55 4.05 0 1.85-.95 3.15-2.6 3.7L19.6 24h-3.1l-2.5-5.55h-1.85V24H9.4Zm2.75-7.85h2.35c1.3 0 2.05-.7 2.05-1.85s-.75-1.85-2.05-1.85h-2.35v3.7Z"
      fill={inverse ? 'var(--color-brand-900)' : '#ffffff'}></path>
    <path d="M20.9 24V10.2h2.6l2.55 6.15 2.55-6.15h.4V24h-2.5v-6.4L24.5 22h-1.1l-2-4.4V24h-.5Z" fill="var(--color-accent-500)"
    ></path>
  </svg>
  <span
    class:list={[
      'font-display text-[1.1875rem] font-bold tracking-[-0.02em]',
      inverse ? 'text-white' : 'text-brand-900',
    ]}
  >
    {empresa.name}
  </span>
</span>
