---
import Logo from './Logo.astro';
import Container from '../ui/Container.astro';
import Icon, { type IconName } from '../ui/Icon.astro';
import WhatsAppCTA from '../tramite/WhatsAppCTA.astro';
import { getTramites, tramiteHref, agruparTramites } from '../../lib/tramites';
import { menu } from '../../lib/navegacion';
import { temaOscuro } from '../../lib/tema';

/**
 * `integrada` quita el fondo de la barra para que se vea el color del hero por
 * debajo. Sólo la pide la home, que es la única página con hero de color; el
 * resto siguen con la barra blanca de siempre, que es el valor por defecto.
 */
interface Props {
  variante?: 'solida' | 'integrada';
}

const { variante = 'solida' } = Astro.props;
const integrada = variante === 'integrada';

/**
 * Sobre el hero oscuro el menú va en blanco. El resto del tiempo —barra
 * sólida, o barra integrada sobre el tema claro— manda el azul de marca.
 */
const sobreOscuro = integrada && temaOscuro;
const tinta = sobreOscuro ? 'text-white/85' : 'text-brand-900';
const tintaHover = sobreOscuro ? 'hover:text-white' : 'hover:text-accent-600';
const tintaActiva = sobreOscuro ? 'text-white' : 'text-accent-600';

const tramites = await getTramites();
const grupos = agruparTramites(tramites);
const path = Astro.url.pathname;
const enTramites = path.startsWith('/tramites');

// Se comparan las dos formas porque `trailingSlash` va en 'ignore': según cómo
// se llegue a la página, el pathname puede traer la barra final o no.
const esActivo = (href: string) => path === href || path === `${href}/`;
---

<header class:list={['sticky top-0 z-50', integrada && 'nav-integrada']}>
  <!-- El fondo con desenfoque va en una capa aparte, no en <header>.
       `backdrop-filter` crea un «containing block» para los descendientes en
       position:fixed (igual que `transform`): el panel del menú móvil,
       fixed con top/bottom para ocupar la pantalla, quedaba anclado al
       header (64px de alto) en vez de al viewport, y se veía aplastado
       detrás del contenido de la página. Al mover el blur a esta capa, el
       header deja de ser containing block y el panel vuelve a posicionarse
       respecto al viewport. -->
  <!-- Integrada, esta capa nace transparente y se enciende sola al salir el
       hero de pantalla (ver el script del final). El color al que se enciende
       lo pone el tema, no el blanco: así el texto del menú no tiene que
       cambiar de color a mitad de scroll. -->
  <div
    aria-hidden="true"
    class:list={[
      'absolute inset-0 -z-10 border-b backdrop-blur-md',
      integrada
        ? 'nav-fondo border-transparent transition-[background-color,border-color] duration-300'
        : 'border-line bg-surface/90',
    ]}
  >
  </div>
  <Container>
    <div class="flex h-16 items-center justify-between gap-4 lg:h-18">
      <div class="flex items-center gap-8">
        <!-- `flex` y no solo `shrink-0`: el contenido del logo es un
             `inline-flex`, que se apoya en la línea base y deja debajo el
             hueco del descendente. Eso hacía la caja del enlace ~41px en vez
             de 34 y subía el logo 4,5px respecto a los enlaces del menú.
             Como contenedor flex desaparece la línea base y ambos centran. -->
        <a href="/" class="flex shrink-0 items-center" aria-label="Ir a la página de inicio">
          <Logo inverse={sobreOscuro} />
        </a>

        <!-- Navegación de escritorio, junto al logo. El desplegable se abre
             con :hover y con :focus-within, así que funciona con teclado sin
             JavaScript. -->
        <nav class="hidden lg:flex lg:items-center lg:gap-1" aria-label="Principal">
          <div class="group relative">
            <a
              href="/#tramites"
              class:list={[
                'flex items-center gap-1 rounded-md px-3 py-2 font-display text-small font-semibold transition-colors',
                enTramites ? tintaActiva : `${tinta} ${tintaHover}`,
              ]}
              aria-current={enTramites ? 'page' : undefined}
            >
              Trámites
              <Icon
                name="chevron"
                size={16}
                class="transition-transform duration-200 group-hover:-rotate-180 group-focus-within:-rotate-180"
              />
            </a>

            <!-- Con veinte trámites la lista plana obligaba a leerla entera;
                 los encabezados de grupo dan el atajo.

                 El reparto va con `columns` y no con una rejilla de una
                 columna por grupo: los grupos tienen tamaños muy dispares
                 —«Otros» es más largo que los otros tres juntos— y una columna
                 por grupo dejaba una muy alta al lado de dos casi vacías. Así
                 el navegador equilibra las tres columnas solo, y sigue
                 haciéndolo si el cliente recoloca trámites desde el panel.
                 `break-inside-avoid` es lo que impide que un grupo se parta
                 dejando su encabezado al final de una columna. -->
            <div
              class="invisible absolute top-full left-0 w-[44rem] pt-2 opacity-0 transition-[opacity,visibility] duration-150 group-hover:visible group-hover:opacity-100 group-focus-within:visible group-focus-within:opacity-100 xl:w-[54rem]"
            >
              <div
                class="columns-3 gap-x-4 rounded-lg border border-line bg-surface p-4 shadow-[var(--shadow-card-hover)]"
              >
                {
                  grupos.map((grupo) => (
                    <div class="mb-5 break-inside-avoid last:mb-0">
                      <p class="px-2 pb-1 font-display text-caption font-semibold tracking-wide text-ink-subtle uppercase">
                        {grupo.etiqueta}
                      </p>
                      <ul>
                        {grupo.tramites.map((tramite) => (
                          <li>
                            <a
                              href={tramiteHref(tramite)}
                              class:list={[
                                'flex items-start gap-2.5 rounded-sm px-2 py-1.5 text-small transition-colors hover:bg-brand-50 hover:text-brand-900',
                                esActivo(tramiteHref(tramite))
                                  ? 'font-semibold text-brand-900'
                                  : 'text-ink-muted',
                              ]}
                              aria-current={esActivo(tramiteHref(tramite)) ? 'page' : undefined}
                            >
                              {/* Alineado con la primera línea, no con el
                                  centro: hay etiquetas que ocupan dos. */}
                              <Icon
                                name={tramite.data.icon as IconName}
                                size={17}
                                class="mt-0.5 shrink-0 text-brand-600"
                              />
                              {tramite.data.shortTitle}
                            </a>
                          </li>
                        ))}
                      </ul>
                    </div>
                  ))
                }
              </div>
            </div>
          </div>

          {
            menu.map((enlace) => (
              <a
                href={enlace.enlace}
                class:list={[
                  'rounded-md px-3 py-2 font-display text-small font-semibold transition-colors',
                  esActivo(enlace.enlace) ? tintaActiva : `${tinta} ${tintaHover}`,
                ]}
                aria-current={esActivo(enlace.enlace) ? 'page' : undefined}
              >
                {enlace.etiqueta}
              </a>
            ))
          }
        </nav>
      </div>

      <div class="hidden shrink-0 lg:block">
        <WhatsAppCTA size="sm" label="WhatsApp" />
      </div>

      <!-- Menú móvil: <details> nativo, sin JavaScript. -->
      <details class="group lg:hidden">
        <summary
          class:list={[
            'flex size-10 cursor-pointer list-none items-center justify-center rounded-md border [&::-webkit-details-marker]:hidden',
            sobreOscuro ? 'border-white/25 text-white' : 'border-line text-brand-900',
          ]}
          aria-label="Abrir menú"
        >
          <Icon name="menu" size={20} class="group-open:hidden" />
          <Icon name="cerrar" size={20} class="hidden group-open:block" />
        </summary>

        <div
          class="fixed inset-x-0 top-16 bottom-0 overflow-y-auto border-t border-line bg-surface px-5 py-6"
        >
          <nav class="flex flex-col gap-6 pb-24" aria-label="Principal">
            <!-- Un solo listado: «Trámites» es una entrada más del menú, al
                 mismo nivel que las demás, y el catálogo cuelga de ella
                 plegado y repartido en grupos. Antes se volcaba suelto en
                 cabeza del panel y quien abría el menú se encontraba de golpe
                 con una lista larga sin saber de qué era. -->
            <ul class="flex flex-col divide-y divide-line">
              <li>
                <!-- `<details>` anidado dentro del `<details>` del menú: el
                     desplegable sigue sin JavaScript. El grupo va con nombre
                     (`group/tramites`) para que su `open` no se confunda con
                     el del panel, que usa el `group` sin nombre. -->
                <details class="group/tramites" open={enTramites}>
                  <summary
                    class:list={[
                      'flex cursor-pointer list-none items-center justify-between gap-3 py-3 font-display font-semibold [&::-webkit-details-marker]:hidden',
                      enTramites ? 'text-accent-600' : 'text-brand-900',
                    ]}
                  >
                    Trámites
                    <Icon
                      name="chevron"
                      size={18}
                      class="shrink-0 text-ink-subtle transition-transform duration-200 group-open/tramites:-rotate-180"
                    />
                  </summary>

                  <!-- Los mismos grupos que en escritorio, aquí apilados. En
                       móvil la lista es aún más larga, así que los
                       encabezados son lo que evita el rollo de veinte
                       enlaces seguidos. -->
                  <div class="flex flex-col gap-4 pb-3">
                    {grupos.map((grupo) => (
                      <div>
                        <p class="px-3 pb-1 font-display text-caption font-semibold tracking-wide text-ink-subtle uppercase">
                          {grupo.etiqueta}
                        </p>
                        <ul class="flex flex-col gap-0.5">
                          {grupo.tramites.map((tramite) => (
                            <li>
                              <a
                                href={tramiteHref(tramite)}
                                class:list={[
                                  'flex items-center gap-3 rounded-sm px-3 py-2.5 text-small',
                                  esActivo(tramiteHref(tramite))
                                    ? 'bg-brand-50 font-semibold text-brand-900'
                                    : 'text-ink-muted',
                                ]}
                                aria-current={esActivo(tramiteHref(tramite)) ? 'page' : undefined}
                              >
                                <Icon
                                  name={tramite.data.icon as IconName}
                                  size={18}
                                  class="shrink-0 text-brand-600"
                                />
                                {tramite.data.shortTitle}
                              </a>
                            </li>
                          ))}
                        </ul>
                      </div>
                    ))}
                  </div>
                </details>
              </li>

              {menu.map((enlace) => (
                <li>
                  <a
                    href={enlace.enlace}
                    class:list={[
                      'flex py-3 font-display font-semibold',
                      esActivo(enlace.enlace) ? 'text-accent-600' : 'text-brand-900',
                    ]}
                    aria-current={esActivo(enlace.enlace) ? 'page' : undefined}
                  >
                    {enlace.etiqueta}
                  </a>
                </li>
              ))}
            </ul>

            <WhatsAppCTA fullWidth label="Contactar por WhatsApp" />
          </nav>
        </div>
      </details>
    </div>
  </Container>
</header>

{
  integrada && (
    <>
      {/*
        Testigo de un píxel justo debajo de la barra. Mientras se ve, la barra
        está sobre el hero y va transparente; cuando sale de pantalla, se
        enciende. Se hace con IntersectionObserver y no escuchando `scroll`
        porque el observador no dispara en cada píxel: sólo en el cruce.
      */}
      <div data-nav-testigo aria-hidden="true" class="pointer-events-none h-px -mt-px w-full" />

      <script>
        const testigo = document.querySelector('[data-nav-testigo]');
        const barra = document.querySelector('.nav-integrada');

        if (testigo && barra) {
          const observador = new IntersectionObserver(
            ([entrada]) => {
              // El atributo lo lee la regla `.nav-integrada[data-fija]`
              // de `global.css`, que es quien enciende el fondo.
              barra.toggleAttribute('data-fija', !entrada.isIntersecting);
            },
            { rootMargin: '0px' },
          );
          observador.observe(testigo);
        }
      </script>
    </>
  )
}
