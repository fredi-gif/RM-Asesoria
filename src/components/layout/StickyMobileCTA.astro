---
import WhatsAppCTA from '../tramite/WhatsAppCTA.astro';
import ImportePerfil from '../tramite/ImportePerfil.astro';
import { totalTramite, type Tramite } from '../../lib/tramites';

/**
 * Barra fija inferior, solo en móvil.
 *
 * En una web de trámites el grueso del tráfico llega desde el móvil y la
 * decisión se toma después de leer la documentación, que queda lejos del CTA
 * de la cabecera. Esta barra evita tener que hacer scroll de vuelta.
 *
 * El `<body>` lleva `pb-20 lg:pb-0` para que no tape el final del contenido.
 */
interface Props {
  mensaje?: string;
  label?: string;
  /** Precio del trámite. La barra muestra el total del perfil activo. */
  precio?: Tramite['data']['precio'];
}

const { mensaje, label = 'Empezar ahora', precio } = Astro.props;
---

<div
  class="fixed inset-x-0 bottom-0 z-40 border-t border-line bg-surface/95 px-4 py-3 backdrop-blur-sm lg:hidden"
>
  <div class="flex items-center gap-3">
    {
      precio && (
        <div class="flex shrink-0 flex-col leading-tight">
          <span class="text-caption text-ink-muted">Desde</span>
          <ImportePerfil
            particular={totalTramite(precio, 'particular')}
            profesional={totalTramite(precio, 'profesional')}
            class="font-display font-bold text-brand-900"
          />
        </div>
      )
    }
    <WhatsAppCTA mensaje={mensaje} size="md" fullWidth label={label} />
  </div>
</div>
