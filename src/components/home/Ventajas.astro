---
import Icon, { type IconName } from '../ui/Icon.astro';

/**
 * Franja de ventajas de la cabecera de la home.
 *
 * Ocupa el sitio donde antes estaba el botón de WhatsApp. No es un CTA: son las
 * cuatro cosas que valen para cualquier trámite y que el visitante quiere
 * confirmar antes de bajar a la rejilla. El botón de contacto sigue en el
 * header, en la barra fija de móvil y en la ficha de cada trámite, así que la
 * conversión no se pierde por quitarlo de aquí.
 *
 * El filete entre celdas es el `gap-px` sobre un fondo del color de la línea:
 * evita bordes dobles y no deja el borde suelto del último elemento.
 *
 * Franja deliberadamente fina: es un recordatorio de cuatro puntos, no un
 * bloque que compita en peso visual con el titular de encima.
 */
interface Props {
  ventajas: { icono: string; texto: string }[];
  /** Sobre el hero oscuro las celdas se vuelven vidrio en vez de blanco. */
  oscuro?: boolean;
  class?: string;
}

const { ventajas, oscuro = false, class: className } = Astro.props;

const marco = oscuro ? 'border-white/15 bg-white/15' : 'border-line bg-line';
const celda = oscuro ? 'bg-white/[0.06]' : 'bg-surface';
const texto = oscuro ? 'text-white' : 'text-brand-900';
---

{
  ventajas.length > 0 && (
    <ul
      class:list={[
        'grid grid-cols-1 gap-px overflow-hidden rounded-lg border sm:grid-cols-2 lg:grid-cols-4',
        marco,
        className,
      ]}
    >
      {ventajas.map((ventaja) => (
        <li class:list={['flex items-center gap-2.5 px-4 py-3 sm:px-5', celda]}>
          <Icon name={ventaja.icono as IconName} size={18} class="shrink-0 text-accent-500" />
          <span class:list={['font-display text-small font-semibold', texto]}>{ventaja.texto}</span>
        </li>
      ))}
    </ul>
  )
}
